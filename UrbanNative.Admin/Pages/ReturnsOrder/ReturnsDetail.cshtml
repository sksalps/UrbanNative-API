@page "{returnId:int}"
@model UrbanNative.Admin.Pages.ReturnsOrder.ReturnsDetailsModel
@{
    ViewData["Title"] = "Return Details";
}

<h3>Return #@Model.Return.ReturnId</h3>

<div class="row">
    <div class="col-md-6">
        <h5>Order & Item</h5>
        <table class="table table-sm">
            <tr><th>Order No</th><td>@Model.Return.OrderNo</td></tr>
            <tr><th>Product</th><td>@Model.Return.ProductName</td></tr>
            <tr><th>SKU</th><td>@Model.Return.SKUCode</td></tr>
            <tr><th>Qty</th><td>@Model.Return.Quantity</td></tr>
            <tr><th>Price</th><td>₹@Model.Return.UnitPrice</td></tr>
            <tr><th>Vendor</th><td>@Model.Return.VendorName</td></tr>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Return Info</h5>
        <table class="table table-sm">
            <tr><th>Type</th><td>@Model.Return.ReturnType</td></tr>
            <tr><th>Status</th><td>@Model.Return.ReturnStatus</td></tr>
            <tr><th>Reason</th><td>@Model.Return.CustomerReason</td></tr>
            <tr><th>Requested</th><td>@Model.Return.RequestedAt</td></tr>
        </table>
    </div>
</div>

<hr />

<h5>Remarks Timeline</h5>
<pre class="bg-light p-2">@Model.Return.Remarks</pre>

@if (Model.Return.ReturnStatus == "REQUESTED")
{
    <hr />
    <h5>Admin Decision</h5>

    <form method="post" asp-page-handler="Decision">
        <input type="hidden" name="ReturnId" value="@Model.Return.ReturnId" />

        <div class="mb-2">
            <label>Admin Comment</label>
            <input class="form-control" name="AdminComment" required />
        </div>

        <div class="mb-2">
            <label>Remarks (append)</label>
            <textarea class="form-control" name="RemarkText" required></textarea>
        </div>

        <button name="IsApproved" value="true" class="btn btn-success">Approve</button>
        <button name="IsApproved" value="false" class="btn btn-danger">Reject</button>
    </form>
}

@if (Model.Return.ReturnStatus == "APPROVED")
{
    <hr />
    <h5>Create Return Shipment</h5>

    <form method="post" asp-page-handler="CreateShipment">
        <input type="hidden" name="ReturnId" value="@Model.Return.ReturnId" />

        <div class="mb-2">
            <input name="CourierName" class="form-control" placeholder="Courier" required />
        </div>

        <div class="mb-2">
            <input name="TrackingNumber" class="form-control" placeholder="Tracking No" required />
        </div>

        <div class="mb-2">
            <textarea name="PickupAddress" class="form-control" placeholder="Pickup Address" required></textarea>
        </div>

        <div class="mb-2">
            <textarea name="DeliveryAddress" class="form-control" placeholder="Delivery Address" required></textarea>
        </div>

        <button class="btn btn-primary">Create Pickup</button>
    </form>
}

@if (Model.Return.ReturnShipmentId != null)
{
    <hr />
    <h5>Shipment</h5>
    <table class="table table-sm">
        <tr><th>Courier</th><td>@Model.Return.CourierName</td></tr>
        <tr><th>Tracking</th><td>@Model.Return.TrackingNumber</td></tr>
        <tr><th>Status</th><td>@Model.Return.ShipmentStatus</td></tr>
    </table>
}
