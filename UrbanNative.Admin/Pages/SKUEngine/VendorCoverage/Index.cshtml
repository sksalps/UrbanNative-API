@page
@model UrbanNative.Admin.Pages.SKUEngine.VendorCoverage.IndexModel

<h3>Vendor SKU Coverage</h3>

<div class="card mb-3">
    <div class="card-body py-2">
        <strong>Product:</strong> @Model.ProductHeader.ProductName
        &nbsp; | &nbsp;
        <strong>Category:</strong> @Model.ProductHeader.CategoryPath
        &nbsp; | &nbsp;
        <strong>Total Combinations:</strong> @Model.ProductHeader.TotalCombinations
    </div>
</div>


<form method="get" class="mb-3">
    <input type="hidden" name="ProductId" value="@Model.ProductId" />

    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               name="IncludeInactiveVendors"
               value="true"
               @(Model.IncludeInactiveVendors ? "checked" : "") />
        <label class="form-check-label">
            Include Inactive Vendors
        </label>
    </div>

    <button type="submit" class="btn btn-sm btn-primary mt-2">
        Apply
    </button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Vendor</th>
            <th>SKUs</th>
            <th>Coverage %</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model.Vendors)
        {
            <tr>
                <td>@v.VendorName</td>
                <td>@v.VendorSkuCount / @v.TotalCombinations</td>
                <td>@v.CoveragePercent %</td>
                <td>
                    <span class="badge bg-@v.StatusCss">@v.Status</span>
                </td>
                <td>
                    
                    <button type="button"        class="btn btn-sm btn-outline-primary"
                            data-vendor-id="@v.VendorID"
                            @(Model.ProductHeader.TotalCombinations == 0 ? "disabled" : "")>
                        View
                    </button>


                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Vendor Coverage Modal -->
<div class="modal fade" id="vendorCoverageModal" tabindex="-1">
    
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-1">SKU Coverage Details</h5>
                    <div class="text-muted small">
                        <strong>Product:</strong> <span id="modalProductName"></span>
                        &nbsp; | &nbsp;
                        <strong>Vendor:</strong> <span id="modalVendorName"></span>
                    </div>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="vendorCoverageContent" class="text-center py-4 text-muted">
                    Select a vendor to view SKU coverage
                </div>

            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        document.addEventListener("click", async function (e) {

            const btn = e.target.closest("[data-vendor-id]");
            if (!btn) return;

            e.preventDefault();

            const vendorId = btn.dataset.vendorId;
            const productId = "@Model.ProductId";

            const modalEl = document.getElementById("vendorCoverageModal");
            const contentEl = document.getElementById("vendorCoverageContent");

            // --------- HEADER CONTEXT ----------
            const productName = "@Model.ProductHeader.ProductName";
            const vendorName = btn.closest("tr")
                .querySelector("td:first-child")
                .innerText;

            document.getElementById("modalProductName").innerText = productName;
            document.getElementById("modalVendorName").innerText = vendorName;

            // --------- LOADER ----------
            contentEl.innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border"></div>
                    <div class="mt-2">Loading SKU coverage…</div>
                </div>`;

            new bootstrap.Modal(modalEl).show();

            try {
                const res = await fetch(
                    `?handler=VendorCoverage&productId=${productId}&vendorId=${vendorId}`
                );

                if (!res.ok)
                    throw new Error("Failed to load");

                const data = await res.json();

                if (!data || data.length === 0) {
                    contentEl.innerHTML =
                        `<div class="alert alert-warning">No SKU data found</div>`;
                    return;
                }

                // --------- TABLE ----------
                let html = `
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">#</th>
                            <th>Variant Combination</th>
                            <th style="width:120px">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                `;

                data.forEach((row, index) => {
                    html += `
                        <tr>
                            <td class="text-center">${index + 1}</td>
                            <td>${row.displayText}</td>
                            <td>
                                <span class="badge ${row.isPresent ? "bg-success" : "bg-danger"}">
                                    ${row.isPresent ? "Present" : "Missing"}
                                </span>
                            </td>
                        </tr>
                    `;
                });

                html += "</tbody></table>";
                contentEl.innerHTML = html;

            } catch (err) {
                console.error(err);
                contentEl.innerHTML =
                    `<div class="alert alert-danger">Failed to load SKU coverage</div>`;
            }
        });
    </script>
}










