@page
@using UrbanNative.Application.DTOs.AdminCategory
@model UrbanNative.Admin.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h3>Categories</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}


<form method="get" class="row g-2 mb-3 align-items-end">

    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input type="text"
               name="search"
               value="@Request.Query["search"]"
               class="form-control"
               placeholder="Category name..." />
    </div>
    
    <div class="col-md-3">
        <label class="form-label">Level</label>
        <select name="level" class="form-select">
            <option value="">All</option>
            <option value="0" selected="@(Request.Query["level"] == "0")">Root</option>
            <option value="1" selected="@(Request.Query["level"] == "1")">Child</option>
        </select>
    </div>


    <div class="col-md-3">
        <label class="form-label">Active</label>
        <select name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(Request.Query["isActive"] == "true")">Active</option>
            <option value="false" selected="@(Request.Query["isActive"] == "false")">Inactive</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in Model.FlatCategories)
            {
                <option value="@cat.CategoryID"
                        selected="@(Request.Query["categoryId"] == cat.CategoryID.ToString())">
                    @cat.DisplayName
                </option>
            }
        </select>
    </div>


    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
            <i class="bi bi-search"></i>
        </button>

        <!-- ADD ROOT CATEGORY -->
        <a asp-page-handler="AddRoot"
           class="btn btn-success flex-fill"
           title="Add Root Category">
            <i class="bi bi-plus-lg"></i>
        </a>


    </div>

</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Category</th>
            <th>Description</th>
            <th>Level</th>
            <th>Children</th>
            <th>Active</th>
            <th>Actions</th>
            <th>Add Child</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var root in Model.Categories.Where(x => x.Level == 0))
        {
            <tr class="category-root" data-category-id="@root.CategoryID">
                <td>
                    <span class="toggle-icon"><span class="icon">▶</span></span>
                    @root.CategoryName
                </td>
                <td>@root.Description</td>
                <td>@root.Level</td>
                <td>@root.ChildCount</td>
                <td>
                    <span class="badge @(root.IsActive ? "bg-success" : "bg-secondary")">
                        @(root.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a asp-page="CategoryDetails"
                       asp-route-id="@root.CategoryID"
                       class="btn btn-sm btn-info">View</a>
                </td>

                <td class="text-center">
                    <!-- ADD SUB CATEGORY -->
                    <a asp-page-handler="AddSub"
                       asp-route-id="@root.CategoryID"
                       class="btn btn-outline-success btn-sm">
                        ➕
                    </a>
                </td>
            </tr>

            @foreach (var child in Model.Categories
                    .Where(x => x.ParentCategoryID == root.CategoryID))
            {
                <tr class="category-child" data-parent-id="@root.CategoryID">
                    <td style="padding-left:40px">@child.CategoryName</td>
                    <td>@child.Description</td>
                    <td>@child.Level</td>
                    <td>@child.ChildCount</td>
                    <td>
                        <span class="badge @(child.IsActive ? "bg-success" : "bg-secondary")">
                            @(child.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <a asp-page="CategoryDetails"
                           asp-route-id="@child.CategoryID"
                           class="btn btn-sm btn-info">View</a>
                    </td>
                    <td class="text-center">
                        <a asp-page-handler="AddSub"
                           asp-route-id="@child.CategoryID"
                           class="btn btn-sm btn-outline-success">
                            ➕
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<button class="btn btn-success"
        data-bs-toggle="modal"
        data-bs-target="#categoryModal">
    Add Root Category
</button>

@await Html.PartialAsync("_CreateEditModal", Model)



@if (Model.OpenCategoryModal)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById("categoryModal");
            if (modalEl) {
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        });
    </script>
}


<script>
    document.querySelectorAll('.category-root').forEach(root => {
        root.addEventListener('click', function (e) {
            if (e.target.closest('a,button')) return;

            const parentId = this.dataset.categoryId;
            const icon = this.querySelector('.icon');

            let show = true;
            document.querySelectorAll(
                `.category-child[data-parent-id='${parentId}']`
            ).forEach(child => {
                show = child.style.display === 'none';
                child.style.display = show ? 'table-row' : 'none';
            });

            if (icon) icon.textContent = show ? '▼' : '▶';
        });
    });
</script>

<style>
    .category-root {
        cursor: pointer;
        font-weight: 600;
    }

    .category-child {
        display: none;
        background-color: #fafafa;
    }

    .toggle-icon {
        width: 16px;
        display: inline-block;
        text-align: center;
        margin-right: 6px;
    }
</style>
