@page
@using UrbanNative.Application.DTOs.AdminCategory
@model UrbanNative.Admin.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";

    var isTreeMode =
    string.IsNullOrEmpty(Request.Query["categoryId"])  // default root view
    || int.TryParse(Request.Query["categoryId"], out _); // specific category

}

@{
    
    bool disableExpand =
    !isTreeMode
    || !string.IsNullOrEmpty(Request.Query["search"])
    || (int.TryParse(Request.Query["level"], out var lvl) && lvl >= 3);

}




<h3>Categories</h3>

<!-- ================= ALERTS ================= -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
    </div>
}

<!-- ================= FILTER BAR ================= -->
<form method="get" class="row g-2 mb-3 align-items-end">

    <!-- Search -->
    <div class="col-md-3">
        <label class="form-label">Search</label>
        <input type="text"
               name="Search"
               value="@Model.Search"
               class="form-control"
               placeholder="Category name..." />
    </div>

    <!-- Category Dropdown -->
    <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="CategoryId" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in Model.AllCategories.OrderBy(x => x.CategoryName))
            {
                <option value="@cat.CategoryID"
                        selected="@(Model.CategoryId == cat.CategoryID)">
                    @cat.CategoryName
                </option>
            }
        </select>
    </div>

    <!-- Level Filter -->
    <div class="col-md-2">
        <label class="form-label">Level</label>
        <select name="Level" class="form-select">
            <option value="">All</option>
            @foreach (var lvl in Model.Categories
                        .Select(x => x.Level)
                        .Distinct()
                        .OrderBy(x => x))
            {
                <option value="@lvl" selected="@(Model.Level == lvl)">
                    Level @lvl
                </option>
            }
        </select>
    </div>

    <!-- Search + Add Root -->
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill" title="Search">
            🔍
        </button>

       
        <button type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#categoryModal"
                data-parent-id="">
            + Root
        </button>

    </div>
</form>

<!-- ================= CATEGORY TABLE ================= -->
<table class="table table-bordered table-hover">

    <thead>
        <tr>
            <th>Category</th>
            <th>Parent</th>
            <th>Description</th>
            <th>Level</th>
            <th>Children</th>
            <th>HSN</th>
            <th>Active</th>
            <th>Actions</th>
            <th>Add Child</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Categories)
        {

            var canExpand =
            isTreeMode &&
            item.ChildCount > 0 &&
            item.Level < 3; // root → child → grandchild

            <tr class="category-row @(item.Level == 0 ? "level-root" : "level-child")"
                data-category-id="@item.CategoryID"
                data-parent-id="@item.ParentCategoryID"
                data-level="@item.Level">

                <!-- CATEGORY NAME (CLICK TARGET) -->
                <td class="category-cell">

                    @* Expand / Collapse icon *@
                    
                    @if (canExpand && !disableExpand)
                    {
                        
                        <span class="expand-icon expand-trigger" data-expanded="false">▶</span>

                    }
                    else
                    {
                        <span class="expand-icon-placeholder"></span>
                    }


                    <span class="category-name expand-trigger">
                        @item.CategoryName
                    </span>

                </td>



                <!-- PARENT CATEGORY -->
                <td>
                    @(item.Level == 0 ? "-" : item.ParentCategoryName)
                </td>

                <!-- DESCRIPTION -->
                <td>
                    @{
                        var desc = item.Description ?? "";
                        var shortDesc = desc.Length > 50
                        ? desc.Substring(0, 50) + "..."
                        : desc;
                    }
                    <span title="@desc">@shortDesc</span>
                </td>

                <td>@item.Level</td>
                <td>@item.ChildCount</td>

                <td>
                    @if (Model.CategoryHSNMap[item.CategoryID] != null)
                    {
                        <a href="javascript:void(0)"
                           class="text-primary fw-bold"
                           onclick="openHsnModal(@item.CategoryID)">
                            @Model.CategoryHSNMap[item.CategoryID]
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-danger"
                              style="cursor:pointer"
                              onclick="openHsnModal(@item.CategoryID)">
                            Not Linked
                        </span>
                    }
                </td>

                <!-- ACTIVE -->
                <td>
                    <button class="btn btn-sm @(item.IsActive ? "btn-warning" : "btn-secondary")"
                            onclick="toggleVendorActive(@item.CategoryID)">
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? "Deactivate" : "Activate")
                        </span>
                        
                    </button>
                </td>

                <!-- ACTION -->
                <td>
                    <a asp-page="CategoryDetails"
                       asp-route-id="@item.CategoryID"
                       class="btn btn-sm btn-info">
                        View
                    </a>
                </td>

                <!-- ADD CHILD -->
                <td class="text-center">

                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            data-bs-toggle="modal"
                            data-bs-target="#categoryModal"
                            data-parent-id="@item.CategoryID"
                            data-breadcrumb="@item.CategoryName">
                        ➕
                    </button>

                </td>
            </tr>
        }
    </tbody>
</table>
<!--HSN Modal to Assign or Change HSN Code to category-->

<!-- HSN Link / Change Modal -->
<div class="modal fade" id="hsnModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Link HSN to Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="categoryId" />

                <div class="mb-3">
                    <label class="form-label">Select HSN</label>
                    <select id="hsnSelect" class="form-select">
                        <option value="">-- Select HSN --</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" onclick="saveCategoryHsn()">Save</button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>

        </div>
    </div>
</div>

<!-- ================= CREATE / EDIT MODAL ================= -->
@await Html.PartialAsync("_CreateEditModal", new AdminCategorySaveDto())

<!-- ================= SCRIPTS ================= -->
@section Scripts {
    <script>
        // Auto dismiss alerts
        /*setTimeout(() => {
            document.querySelectorAll('.alert')
                .forEach(a => a.remove());
        }, 3000); */


        document.addEventListener('click', function (e) {

            const trigger = e.target.closest('.expand-trigger');
            if (!trigger) return;

            const row = trigger.closest('tr');
            const icon = row.querySelector('.expand-icon');
            if (!icon) return;

            e.preventDefault();
            e.stopPropagation();

            const parentId = row.dataset.categoryId;
            const parentLevel = parseInt(row.dataset.level);
            const expanded = icon.dataset.expanded === 'true';

            document.querySelectorAll(
                `.category-row[data-parent-id='${parentId}']`
            ).forEach(child => {

                const childLevel = parseInt(child.dataset.level);

                // allow only child + grandchild
                if (childLevel <= parentLevel + 2) {
                    child.classList.toggle('d-none', expanded);
                }
            });

            icon.textContent = expanded ? '▶' : '▼';
            icon.dataset.expanded = (!expanded).toString();
        });

        // Set ParentCategoryID in modal
        document.getElementById('categoryModal')
            .addEventListener('show.bs.modal', function (event) {

                const button = event.relatedTarget;
                const parentId = button?.getAttribute('data-parent-id') || '';
                const parentName = button?.getAttribute('data-breadcrumb');

                // Set hidden ParentCategoryID
                document.getElementById('ParentCategoryID').value = parentId;

                const title = document.getElementById('categoryModalLabel');
                const breadcrumbContainer = document.getElementById('categoryBreadcrumbContainer');
                const breadcrumb = document.getElementById('categoryBreadcrumb');

                breadcrumb.innerHTML = '';

                if (!parentId) {
                    // Root category
                    title.textContent = 'Add Root Category';
                    breadcrumbContainer.classList.add('d-none');
                } else {
                    title.textContent = 'Add Subcategory';
                    breadcrumbContainer.classList.remove('d-none');

                    breadcrumb.innerHTML = `
                        <li class="breadcrumb-item">
                            <span>${parentName}</span>
                        </li>
                    `;
                }
            });


            async function toggleVendorActive(categoryid) {
            if (!confirm("Are you sure you want to change active status?"))
                return;

            const res = await fetch(`${API_BASE}/api/admin/categories/activate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify(categoryid)   // 🔥 IMPORTANT
            });

            if (res.ok) {
                location.reload();
            } else {
                const text = await res.text();
                alert(`Failed to update status (${res.status}): ${text}`);
            }
        }

    </script>

    <script>
        // Open HSN Modal to assign / change HSN Code
                function openHsnModal(categoryId) {
            document.getElementById('categoryId').value = categoryId;

            fetch(`${API_BASE}/api/admin/hsn`, {
                credentials: 'include'
            })
            .then(r => {
                if (!r.ok) throw new Error('API error');
                return r.json();
            })
            .then(data => {
                const ddl = document.getElementById('hsnSelect');
                ddl.innerHTML = '<option value="">-- Select HSN --</option>';

                data.forEach(h => {
                    ddl.innerHTML += `<option value="${h.hsnId}">
                        ${h.hsnCode} (${h.gstPercentage}%)
                    </option>`;
                });

                new bootstrap.Modal(document.getElementById('hsnModal')).show();
            })
            .catch(err => {
                console.error(err);
                alert('Unable to load HSN list');
            });
        }

        function saveCategoryHsn() {
            const categoryId = document.getElementById('categoryId').value;
            const hsnId = document.getElementById('hsnSelect').value;

            if (!hsnId) {
                alert('Please select HSN');
                return;
            }

            fetch(`${API_BASE}/api/admin/categories/${categoryId}/hsn`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',   // 🔥 REQUIRED
                body: JSON.stringify(parseInt(hsnId))
            })
            .then(res => {
                if (!res.ok) throw new Error('Save failed');
                location.reload();
            })
            .catch(err => {
                console.error(err);
                alert('Failed to save HSN mapping');
            });
        }

    </script>

    <style>
        .category-child {
            background-color: #fafafa;
        }

        .category-cell {
            white-space: nowrap;
        }

        .expand-icon {
            cursor: pointer;
            font-size: 14px;
            margin-right: 6px;
            color: #0d6efd;
            display: inline-block;
            width: 16px;
        }

        .expand-icon-placeholder {
            display: inline-block;
            width: 16px;
            margin-right: 6px;
        }

        .category-root {
            cursor: pointer;
            font-weight: 600;
        }

        .category-row.level-child {
            display: none;
        }

        .category-row.d-none {
            display: none !important;
        }

    </style>
}
