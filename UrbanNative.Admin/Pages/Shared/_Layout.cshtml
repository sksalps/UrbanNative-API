@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery AntiForgery

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UrbanNative Admin - @ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />

    @* CSRF token for JS if needed *@
    <meta name="RequestVerificationToken" content="@AntiForgery.GetAndStoreTokens(Context).RequestToken" />

</head>
<body class="admin-body">
    <div class="d-flex" id="admin-root">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar mini">
            @await Html.PartialAsync("_Sidebar")
        </nav>

        <!-- Page content -->
        <div class="flex-grow-1">
            @await Html.PartialAsync("_Topbar")

            <main class="container-fluid p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS (bundle includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery (required by DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Site JS (small) -->
    <script>
        // Sidebar toggle
        const sidebar = document.getElementById('sidebar');
        window.toggleSidebar = () => {
          sidebar.classList.toggle('mini');
          localStorage.setItem('sidebarMini', sidebar.classList.contains('mini') ? '1' : '0');
        };
        // restore state
        if (localStorage.getItem('sidebarMini') === '0') sidebar.classList.remove('mini');
    </script>

    @RenderSection("Scripts", required: false)

    <script>
        // -------------------------
        // Dark mode (keep as-is)
        // -------------------------
        function toggleDarkMode() {
            document.body.classList.toggle("dark");
            localStorage.setItem(
                "darkMode",
                document.body.classList.contains("dark") ? "1" : "0"
            );
        }

        if (localStorage.getItem("darkMode") === "1") {
            document.body.classList.add("dark");
        }

        // -------------------------
        // Notifications
        // -------------------------
        const csrfToken = document
            .querySelector('meta[name="RequestVerificationToken"]')
            ?.getAttribute("content");

        async function loadNotifications() {
            try {
                // unread notifications
                const res = await fetch("/api/admin/notifications/unread");
                if (!res.ok) return;

                const list = await res.json();
                const ul = document.getElementById("notifList");
                const badge = document.getElementById("notifCount");

                badge.innerText = list.length;
                badge.style.display = list.length > 0 ? "inline-block" : "none";

                ul.innerHTML = "";

                if (list.length === 0) {
                    ul.innerHTML =
                        "<li class='dropdown-item text-muted text-center small'>No new notifications</li>";
                    return;
                }

                list.forEach(item => {
                    ul.innerHTML += `
                        <li class="dropdown-item notification-item"
                            onclick="markNotificationRead(${item.id})">
                            <strong>${item.title}</strong><br/>
                            <small class="text-muted">${item.message ?? ""}</small>
                        </li>
                    `;
                });
            } catch (err) {
                console.error("Notification error:", err);
            }
        }

        async function markNotificationRead(id) {
            try {
                await fetch(`/api/admin/notifications/${id}/read`, {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": csrfToken
                    }
                });
                loadNotifications();
            } catch (err) {
                console.error("Mark read failed:", err);
            }
        }

        // initial load + auto refresh
        document.addEventListener("DOMContentLoaded", () => {
            loadNotifications();
            setInterval(loadNotifications, 15000); // 15 sec
        });
    </script>

</body>
</html>
