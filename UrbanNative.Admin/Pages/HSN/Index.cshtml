@page
@model UrbanNative.Admin.Pages.HSN.IndexModel

<h3>HSN Management</h3>
<a asp-page="/GST/Index" class="btn btn-secondary mb-3">← Back to GST Management</a>


<form method="get" class="row g-2 mb-3 align-items-end">

    <!-- 🔍 Search -->
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="HSN Code or Description" />
    </div>

    <!-- 📊 GST % Filter -->
    <div class="col-md-3">
        <label class="form-label">GST %</label>
        <select name="gstId" class="form-select">
            <option value="">All GST</option>
            @foreach (var gst in Model.GstList)
            {
                <option value="@gst.Value" selected="@gst.Selected">
                    @gst.Text
                </option>
            }
        </select>
    </div>

    <!-- ✅ Status Filter -->
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(Model.IsActive == true)">
                Active
            </option>
            <option value="false" selected="@(Model.IsActive == false)">
                Inactive
            </option>
        </select>
    </div>

    <!-- 🔘 Actions -->
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-page="CreateHSN" class="btn btn-success">
            + Add HSN
        </a>
    </div>

</form>



<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>HSN Code</th>
            <th>Description</th>
            <th>GST %</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.HSNId</td>
                <td>@item.HSNCode</td>
                <td>@item.Description</td>
                <td>@item.GSTPercentage%</td>
                <td>
                    <span class="badge bg-@(item.IsActive ? "success" : "secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a asp-page="EditHSN"asp-route-hsnId="@item.HSNId" class="btn btn-sm btn-info">
                        Edit
                    </a>

                    <form method="post" asp-page-handler="Toggle" asp-route-hsnId="@item.HSNId"
                          class="d-inline">
                        <button class="btn btn-sm btn-warning">
                            @(item.IsActive ? "Inactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
