@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>UrbanNative Admin - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="admin-shell">
        <div class="admin-sidebar">
            @* optional: if you created Pages/Shared/_Sidebar.cshtml, it will render here *@
            @if (System.IO.File.Exists(Context.RequestServices.GetRequiredService<IWebHostEnvironment>().ContentRootPath + "/Pages/Shared/_Sidebar.cshtml"))
            {
                <partial name="~/Pages/Shared/_Sidebar.cshtml" />
            }
        </div>

        <div class="admin-main">
            @* your existing _Topbar.cshtml is in /Pages — render it *@
            @await Html.PartialAsync("~/Pages/_Topbar.cshtml")

            <main class="admin-content">
                @RenderBody()
            </main>

            @if (System.IO.File.Exists(Context.RequestServices.GetRequiredService<IWebHostEnvironment>().ContentRootPath + "/Pages/Shared/_Footer.cshtml"))
            {
                <partial name="~/Pages/Shared/_Footer.cshtml" />
            }
        </div>
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/admin.js"></script>
</body>
</html>