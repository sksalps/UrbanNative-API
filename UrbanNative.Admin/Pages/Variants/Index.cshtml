@page
@model UrbanNative.Admin.Pages.Variants.IndexModel
@{
    ViewData["Title"] = "Variants";
}

<h3>Variants</h3>

<form method="get" class="row mb-3 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input name="search"
               value="@Request.Query["search"]"
               class="form-control"
               placeholder="Search Variant" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="isActive" class="form-select">
            <option value="">All</option>
            <option value="true" selected="@(Request.Query["isActive"] == "true")">Active</option>
            <option value="false" selected="@(Request.Query["isActive"] == "false")">Inactive</option>
        </select>
    </div>

    <div class="col-md-5">
        <button class="btn btn-primary me-2">Filter</button>

        <a asp-page="./CreateEditVariant"
           class="btn btn-success">
            + Add Variant
        </a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th width="80">ID</th>
            <th>Variant Name</th>
            <th width="150">Total Values</th>
            <th width="120">Status</th>
            <th width="200">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model.Variants)
        {
            <tr>
                <td>@v.VariantID</td>

                <!-- Variant name -->
                <td>
                    <a asp-page="./VariantDetails"
                       asp-route-variantId="@v.VariantID">
                        @v.VariantName
                    </a>
                </td>

                <!-- Total Values clickable -->
                <td>
                    <a asp-page="./VariantDetails"
                       asp-route-variantId="@v.VariantID"
                       class="text-decoration-underline">
                        @v.TotalValues
                    </a>
                </td>

                <!-- Toggle status (Vendor-style) -->
                <td>
                    <form method="post"
                          asp-page-handler="Toggle"
                          asp-route-id="@v.VariantID"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-sm @(v.IsActive ? "btn-success" : "btn-secondary")">
                            @(v.IsActive ? "Active" : "Inactive")
                        </button>
                    </form>
                </td>

                <!-- Actions -->
                <td>
                    <a asp-page="./VariantDetails"
                       asp-route-variantId="@v.VariantID"
                       class="btn btn-sm btn-info me-2">
                        View
                    </a>

                    <form method="post"
                          asp-page-handler="Toggle"
                          asp-route-id="@v.VariantID"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-sm @(v.IsActive ? "btn-warning" : "btn-success")">
                            @(v.IsActive ? "Inactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
