@page
@model LoginModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>UrbanNative Admin - Login</title>

    <!-- Modern Login Page CSS -->
    <link rel="stylesheet" href="~/css/adminlogin.css" />
</head>

<body class="login-page">

    <div class="login-container">
        <h2>UrbanNative Admin</h2>

        <form method="post" class="login-form">
            <div class="form-group">
                <label asp-for="Identifier">Email or Username</label>
                <input asp-for="Identifier" />
                <span asp-validation-for="Identifier" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login">Sign in</button>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error">@Model.ErrorMessage</div>
            }
        </form>
    </div>

</body>
</html>
