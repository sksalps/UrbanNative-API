<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - UrbanNative Vendor</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Vendor Layout CSS -->
    <link rel="stylesheet" href="~/css/vendor-layout.css" />
</head>
<body>

    <div class="vendor-shell">

        <!-- ============ SIDEBAR ============ -->
        @await Html.PartialAsync("_VendorSidebar")

        <!-- ============ MAIN ============ -->
        <div class="vendor-main">

            <!-- Topbar -->
            <header class="vendor-topbar">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="fw-semibold">
                        @ViewData["Title"]
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-bell"></i>
                        <span class="fw-semibold">@User.Identity?.Name</span>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="vendor-content container-fluid">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="vendor-footer">
                © 2026 UrbanNative Vendor Portal
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.querySelectorAll('.menu-item.has-sub > a').forEach(el => {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                this.parentElement.classList.toggle('open');
            });
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
