@* UrbanNative Vendor Topbar *@

<header class="vendor-topbar">
    <div class="d-flex justify-content-between align-items-center w-100">

        <!-- Page Title -->
        <div class="fw-semibold text-dark">
            @ViewData["Title"]
        </div>

        <!-- Right Actions -->
        <div class="d-flex align-items-center gap-4">

            <!-- Notifications (Phase-2 logic) -->
            <button class="btn btn-light position-relative" type="button">
                <i class="bi bi-bell fs-5"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    2
                </span>
            </button>
            <div class="vendor-avatar">
                @AvatarHelper.GetInitials(User.Identity?.Name)
            </div>

            <!-- Profile Dropdown -->
            <div class="dropdown">
                
                <button class="btn profile-btn dropdown-toggle d-flex align-items-center"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <span class="me-1">🙂</span>
                    <i class="bi bi-caret-down-fill profile-caret"></i>
                </button>


                <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                    <li class="dropdown-header fw-bold text-muted">
                        Vendor Account
                    </li>

                    <!-- My Profile -->
                    <li>
                        <a class="dropdown-item"  asp-page="/Business/VendorProfile">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                    </li>

                    <!-- Set Options -->
                    <li>
                        <a class="dropdown-item" asp-page="/Settings/Index">
                            <i class="bi bi-sliders me-2"></i> Set Options
                        </a>
                    </li>

                    <!-- Change Password -->
                    <li>
                        <a class="dropdown-item" asp-page="/Settings/ChangePassword">
                            <i class="bi bi-key me-2"></i> Change Password
                        </a>
                    </li>

                    <li><hr class="dropdown-divider" /></li>

                    <!-- Logout -->
                    <li>
                        <a class="dropdown-item text-danger" asp-page="/Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>

                </ul>
            </div>

        </div>

    </div>
</header>
