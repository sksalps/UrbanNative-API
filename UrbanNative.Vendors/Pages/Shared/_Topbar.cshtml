@* UrbanNative Vendor Topbar *@

<header class="vendor-topbar">
    @{
        var vendorName = User.Identity?.Name;
    }
    <div class="d-flex justify-content-between align-items-center w-100">

        <!-- Page Title -->
        <div class="fw-semibold text-dark">
            @ViewData["Title"]
        </div>

        <!-- Right Actions -->
        <div class="d-flex align-items-center gap-4">

            <!-- Notifications (Phase-2 logic) -->
            <button class="btn btn-light position-relative" type="button">
                <i class="bi bi-bell fs-5"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    2
                </span>
            </button>

            <!-- Profile Dropdown -->
            <div class="dropdown">
                
                <button class="btn d-flex align-items-center gap-2 dropdown-toggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <div class="vendor-avatar">
                        @AvatarHelper.GetInitials(vendorName)
                    </div>

                    <i class="bi bi-caret-down-fill small"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li class="dropdown-header fw-semibold">
                        @vendorName
                    </li>

                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" href="/Business/VendorProfile">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-page="/Settings/Index">
                            <i class="bi bi-sliders me-2"></i> Set Options
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/Settings/ChangePassword">
                            <i class="bi bi-key me-2"></i> Change Password
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-page="/Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>

        </div>

    </div>
</header>
