@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@RenderSection("Styles", required: false)
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="api-base-url" content="@Configuration["ApiSettings:BaseUrl"]" />
	<!--        
        <meta name="jwt-token" content="User.FindFirst("access_token")?.Value" />
        
        <meta name="jwt-token" content="Context.Request.Cookies["VendorJwt"]" />
    -->
    <link href="~/css/vendor-logistics.css" rel="stylesheet" />

    <title>@ViewData["Title"] - UrbanNative Vendor</title

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Vendor Layout CSS -->
    <link rel="stylesheet" href="~/css/vendor-layout.css" />
    <link rel="stylesheet" href="~/_content/UrbanNative.Shared/css/common.css" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
    <script src="~/js/vendor-logistics.js"></script>
   
    
    <style>
        .form-label .text-danger {
    display: inline !important;
    font-weight: 600;
}
    /* Fix double layer */
.ts-wrapper.single .ts-control {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 10px;
}

/* Hide weird duplicate input look */
.ts-control input {
    flex: 1;
    min-width: 60px;
}

/* Dropdown layering fix */
.ts-dropdown {
    z-index: 99999 !important;
}

/* Clean look */
.ts-wrapper {
    width: 100%;
}
</style>
</head>
<body>

    <div class="vendor-shell">

        <!-- ============ SIDEBAR ============ -->
        @await Html.PartialAsync("_Sidebar")

        <!-- ============ MAIN ============ -->
        <div class="vendor-main">

            <!-- Topbar -->
            @await Html.PartialAsync("_Topbar")

            <!-- Page Content -->
            <main class="vendor-content container-fluid">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="vendor-footer">
                © 2026 UrbanNative Vendor Portal
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.querySelectorAll('.menu-item.has-sub > a').forEach(el => {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                this.parentElement.classList.toggle('open');
            });
        });
    </script>
  
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(
                document.querySelectorAll('[data-bs-toggle="tooltip"]')
            );
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>


    @RenderSection("Scripts", required: false)

</body>
</html>
