@page
@model UrbanNative.Vendors.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
}

<h4 class="mb-3">Inventory Log View</h4>

<form method="get" class="row g-2 mb-3">

    <!-- Category -->
    <div class="col-md-3">
        <label class="form-label">Category</label>
        
        <select asp-for="CategoryId"
                asp-items="Model.CategoryList"
                class="form-select"
                onchange="this.form.submit()">
            <option value="">-- Category --</option>
        </select>

    </div>

    <!-- Product -->
    <div class="col-md-3">
        <label class="form-label">Product</label>
        @if (!Model.HasCategory)
        {
            <select class="form-select" disabled>
                <option>-- Product --</option>
            </select>
        }
        else
        {
            <select asp-for="ProductId"
                    asp-items="Model.ProductList"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="">-- Product --</option>
            </select>
        }
    </div>



    <!-- SKU (readonly when auto-filled) -->
    <div class="col-md-3 position-relative">
        <label class="form-label">SKU</label>

        <input type="text"
               id="skuSearch"
               class="form-control"
               placeholder="Search SKU"
               value="@Model.SelectedSkuDisplay"
               readonly="@(Model.ProductId == null)" />

        <input type="hidden" id="SkuId" name="SkuId" value="@Model.SkuId" />

        <ul id="skuSuggestions"
            class="list-group position-absolute w-100 d-none"
            style="z-index: 1000;">
        </ul>
    </div>



    <!-- Warehouse -->
    <div class="col-md-3">
        <label class="form-label">Warehouse</label>
        <select asp-for="AddressId"
                asp-items="Model.WarehouseList"
                class="form-select">
        </select>
    </div>

    <!-- From Date -->
    <div class="col-md-3">
        <label class="form-label">From Date</label>
        <input type="date"
               class="form-control"
               name="FromDate"
               value="@Model.FromDate.ToString("yyyy-MM-dd")" />
    </div>

    <!-- To Date -->
    <div class="col-md-3">
        <label class="form-label">To Date</label>
        <input type="date"
               class="form-control"
               name="ToDate"
               value="@Model.ToDate.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <!-- Apply -->
        <button type="submit" class="btn btn-primary flex-fill">
            Apply
        </button>

        <!-- Clear Filters -->
        <a href="/Inventory" class="btn btn-outline-secondary">
            Clear
        </a>

        <!-- Back -->
        <button type="button"
                class="btn btn-outline-dark"
                onclick="history.back();">
            Back
        </button>
    </div>

</form>
@if (Model.CategoryId.HasValue || Model.SkuId > 0)
{
    <div class="card mb-3 border-info shadow-sm">
        <div class="card-body py-3 px-3">

            <div class="row gy-2 align-items-start">

                <div class="col-md-3">
                    <div class="text-muted small">Category</div>
                    <div class="fw-semibold">@Model.SelectedCategoryName</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Product</div>
                    <div class="fw-semibold">@Model.SelectedProductName</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">SKU</div>
                    <div class="fw-semibold">@Model.SelectedSkuDisplay</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small"><strong>@Model.SelectedWarehouseName</strong></div>
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedWarehouseFullAddress))
                    {
                        <div class="text-muted small mt-1"
                             style="white-space: pre-line; line-height: 1.3;">
                            @Model.SelectedWarehouseFullAddress
                        </div>
                    }
                </div>

                <!-- Divider -->
                <div class="col-12">
                    <hr class="my-2" />
                </div>

                <!-- Period -->
                <div class="col-12 text-muted small">
                    Period:
                    <strong>
                        @Model.FromDate.ToString("dd-MM-yyyy")
                        →
                        @Model.ToDate.ToString("dd-MM-yyyy")
                    </strong>
                </div>

            </div>

        </div>
    </div>
}



@if (Model.SkuId > 0)
{
    <!-- Summary -->
    <div class="row text-center mb-4">
        <div class="col"><div class="card p-2">Opening<br /><strong>@Model.Summary.OpeningStock</strong></div></div>
        <div class="col"><div class="card p-2">Total In<br /><strong>@Model.Summary.TotalIn</strong></div></div>
        <div class="col"><div class="card p-2">Total Out<br /><strong>@Model.Summary.TotalOut</strong></div></div>
        <div class="col"><div class="card p-2">Closing<br /><strong>@Model.Summary.ClosingStock</strong></div></div>
        <div class="col"><div class="card p-2">Current<br /><strong>@Model.Summary.CurrentStock</strong></div></div>
    </div>

    <!-- Logs -->
    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>SKU</th>
                <th>WH</th>
                <th>Date</th>
                <th>Type</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Old</th>
                <th class="text-end">New</th>
                <th>Ref</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <!-- SKU Code -->
                    <td>
                        <span class="fw-semibold">@log.SKUCode</span>
                    </td>

                    <!-- Warehouse ID -->
                    <td class="text-muted">
                        @log.AddressID
                    </td>

                    <!-- Date -->
                    <td title="@log.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")">
                        @log.CreatedAt.ToString("dd-MM-yyyy")
                    </td>

                    <!-- Type -->
                    <td>
                        <span class="badge
                        @(log.ChangeType == "IN" ? "bg-success" :
                                                log.ChangeType == "OUT" ? "bg-danger" :
                                                log.ChangeType == "INIT" ? "bg-info" :
                                                "bg-secondary")">
                            @log.ChangeType
                        </span>
                    </td>

                    <!-- Qty -->
                    <td class="text-end">@log.Quantity</td>

                    <!-- Old -->
                    <td class="text-end">@log.OldStock</td>

                    <!-- New -->
                    <td class="text-end fw-semibold">@log.NewStock</td>

                    <!-- Ref -->
                    <td>@log.ReferenceType</td>

                    <!-- Remarks -->
                    <td title="@log.Remarks">@log.Remarks</td>
                </tr>
            }
        </tbody>


    </table>
}
else
{
    <div class="alert alert-info">
        Select a SKU to view inventory logs.
    </div>
}


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const skuInput = document.getElementById("skuSearch");
            const skuList = document.getElementById("skuSuggestions");
            const skuIdInput = document.getElementById("SkuId");
            const productId = parseInt("@Model.ProductId") || 0;

            if (!skuInput || !skuList) {
                console.warn("SKU elements not found");
                return;
            }

            skuInput.addEventListener("input", async function () {
                const q = this.value.trim();

                if (!q || productId === 0) {
                    skuList.classList.add("d-none");
                    return;
                }
                //alert (productId+"q="+ q);
                const apiBase = document.querySelector('meta[name="api-base-url"]').getAttribute("content");
                const url = `${apiBase}/api/skufilter/skus?productId=${productId}&q=${encodeURIComponent(q)}`;
                //const url = `/api/skufilter/skus?productId=${productId}&q=${encodeURIComponent(q)}`;
                //console.log("Fetching:", url);
                //alert (productId+"url"+ url);
                const res = await fetch(url);
                if (!res.ok) return;

                const data = await res.json();
                console.log("SKU DATA:", data);
        //alert(JSON.stringify(data));

                skuList.innerHTML = "";

                if (!data.length) {
                    skuList.classList.add("d-none");
                    return;
                }

                data.forEach(sku => {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action";
                    li.textContent = `${sku.skuCode} | ${sku.variantText}`;

                    li.addEventListener("click", () => {
                        skuInput.value = li.textContent;
                        skuIdInput.value = sku.skuId;
                        skuList.classList.add("d-none");
                        skuInput.closest("form").submit();
                    });

                    skuList.appendChild(li);
                });

                skuList.classList.remove("d-none");
            });

            document.addEventListener("click", e => {
                if (!skuList.contains(e.target) && e.target !== skuInput) {
                    skuList.classList.add("d-none");
                }
            });
        });
    </script>
}
