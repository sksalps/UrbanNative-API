@page
@model AdjustSkuStockModel
@{
    ViewData["Title"] = "Adjust Stock to SKU";
}
<!--
if (!string.IsNullOrWhiteSpace(Model.GlobalErrorMessage))
{
    <div class="text-danger fw-semibold">
        Model.GlobalErrorMessage
    </div>
}
-->

<div class="container-fluid">

    <h4 class="mb-3">Add Stock to Single SKU</h4>

    <div class="row g-3 align-items-stretch" style="min-height:65vh;">

        <!-- ================= LEFT : SELECTORS (30%) ================= -->
        <div class="col-md-4 d-flex">
            <div class="card flex-fill">

                <form method="get">

                    <div class="card h-100">
                        <div class="card-header fw-bold">
                            Select SKU
                        </div>

                        <div class="card-body">

                            <!-- CATEGORY -->
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select"
                                        asp-for="CategoryId"
                                        asp-items="Model.CategoryList"
                                        onchange="this.form.submit()">
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>

                            <!-- PRODUCT -->
                            <div class="mb-3">
                                <label class="form-label">Product</label>

                                @if (Model.CategoryId == null)
                                {
                                    <select class="form-select" disabled>
                                        <option>-- Select Product --</option>
                                    </select>
                                }
                                else
                                {
                                    <select class="form-select"
                                            asp-for="ProductId"
                                            asp-items="Model.ProductList"
                                            onchange="this.form.submit()">
                                        <option value="">-- Select Product --</option>
                                    </select>
                                }
                            </div>

                            <!-- SKU (TYPO FILTER) -->
                            <div class="mb-3 position-relative">
                                <label class="form-label">SKU</label>

                                @if (Model.ProductId == null)
                                {
                                    <input class="form-control"
                                           placeholder="Select Product first"
                                           disabled />
                                }
                                else
                                {
                                    <input type="text"
                                           id="skuSearch"
                                           class="form-control"
                                           placeholder="Type SKU code or variant..."
                                           autocomplete="off"
                                           value="@Model.SelectedSkuDisplay" />

                                    <input type="hidden" asp-for="SkuId" />
                                    <input type="hidden" id="ProductIdHidden" value="@Model.ProductId" />

                                    <ul id="skuSuggestions"
                                        class="list-group position-absolute w-100 d-none"
                                        style="z-index:1000;"></ul>
                                }
                            </div>

                            <!-- WAREHOUSE -->
                            <div class="mb-3">
                                <label class="form-label">Warehouse</label>

                                @if (!Model.HasSku)
                                {
                                    <select class="form-select" disabled>
                                        <option>-- Select Warehouse --</option>
                                    </select>
                                }
                                else
                                {
                                    <select class="form-select"
                                            asp-for="AdjustRequest.WarehouseId"
                                            asp-items="Model.WarehouseList"
                                            onchange="this.form.submit()">
                                        <option value="">-- Select Warehouse --</option>
                                    </select>
                                }
                            </div>

                        </div>
                    </div>

                </form>
            </div>
        </div>

        <!-- ================= RIGHT : SUMMARY + FORM (70%) ================= -->
        <div class="col-md-8 d-flex flex-column">

            <!-- ===== SKU SUMMARY ===== -->
            <div class="card flex-fill mb-3 d-flex">

                <div class="card-header fw-bold">
                    SKU Summary
                </div>

                <div class="card-body d-flex align-items-center justify-content-center">

                    @if (!Model.HasSku)
                    {
                        <!-- INITIAL STATE -->
                        <div class="text-center text-muted">
                            <h6 class="fw-semibold">Select SKU for Summary</h6>
                            <p class="mb-0">
                                Choose <b>Category → Product → SKU</b><br />
                                from the left panel
                            </p>
                        </div>
                    }

                    else if (Model.Summary == null && !string.IsNullOrWhiteSpace(Model.GlobalErrorMessage))
                    {
                        <div class="text-center text-danger">
                            <h6 class="fw-semibold mb-1">Unable to load SKU summary</h6>
                            <div class="small">@Model.GlobalErrorMessage</div>
                        </div>
                    }

                    else if (!Model.Summary.IsInitiated)
                    {
                        <!-- NOT INITIATED -->
                        <div class="alert alert-warning mb-0">
                            This SKU is not initiated.<br />
                            Please complete SKU entry before updating inventory.
                        </div>
                    }
                    else
                    {
                        <!-- READY STATE -->
                        <div class="w-100">

                            <div class="row">
                                <div class="col-md-6">
                                    <div><strong>Category:</strong> @Model.SelectedCategoryName</div>
                                    <div><strong>Product:</strong> @Model.SelectedProductName</div>
                                    <div><strong>SKU:</strong> @Model.SelectedSkuDisplay</div>
                                </div>

                                <div class="col-md-6">
                                    <div><strong>Product Stock:</strong> @Model.Summary.ProductStock</div>
                                    <div><strong>Overall SKU Stock:</strong> @Model.Summary.OverallSkuStock</div>
                                    <div><strong>Warehouse Stock:</strong> @Model.Summary.WarehouseStock</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.SelectedWarehouseFullAddress))
                            {
                                <hr />
                                <small class="text-muted">
                                    <strong>Warehouse: #@Model.AdjustRequest.WarehouseId</strong><br />
                                    @Model.SelectedWarehouseFullAddress
                                </small>
                            }

                        </div>
                    }

                </div>
            </div>

            <!-- ===== ADD INVENTORY FORM ===== -->
            <div class="card">

                <div class="card-header fw-bold">
                    Adjust Inventory (A SKU)
                </div>

                <div class="card-body">

                    @if (!Model.HasSku)
                    {
                        <p class="text-muted mb-0">
                            Please select SKU to adjust stock in single SKU.
                        </p>
                    }
                    else
                    {
                        <form method="post" id="adjustInventoryForm">

                            <input type="hidden" asp-for="CategoryId" />
                            <input type="hidden" asp-for="ProductId" />
                            <input type="hidden" asp-for="AdjustRequest.SKUId" />
                            <input type="hidden" asp-for="AdjustRequest.WarehouseId" />

                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Change Type</label>
                                    <select class="form-select"
                                            asp-for="@Model.AdjustRequest.ChangeType"
                                            onchange="recalculateStock()">
                                        <option value="IN">Increase</option>
                                        <option value="OUT">Decrease</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Quantity</label>

                                    @if (Model.IsSuccess)
                                    {
                                        <input class="form-control" type="number"
                                               value="@Model.AdjustRequest.Quantity" disabled />
                                    }
                                    else
                                    {
                                        <input asp-for="AdjustRequest.Quantity" type="number"
                                               min="1" class="form-control" oninput="recalculateStock()" />
                                        <span asp-validation-for="AdjustRequest.Quantity" class="text-danger"></span>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Reason</label>

                                    @if (Model.IsSuccess)
                                    {
                                        <textarea class="form-control"
                                          rows="1" disabled>@Model.AdjustRequest.Reason</textarea>
                                    }
                                    else
                                    {
                                        <textarea asp-for="AdjustRequest.Reason"
                                                  class="form-control"
                                                  rows="1"
                                                  placeholder="Mandatory reason for adjustment"></textarea>
                                        <span asp-validation-for="AdjustRequest.Reason" class="text-danger"></span>
                                    }
                                </div>

                            </div>

                        </form>
                    }

                </div>
            </div>

        </div>
    </div>

    <!-- ================= ACTION ROW ================= -->
    @if (Model.Summary != null)
    { 
    <div class="row mt-3">
        <div class="col-md-12">

            <div class="d-flex align-items-center gap-3">
                <div class="flex-grow-1">
                    <!-- MATH -->
                    <div class="flex-grow-1 fw-semibold">
                        Warehouse Current Stock:
                        <span id="currentStock">@Model.Summary.WarehouseStock</span>
                        &nbsp; | &nbsp;
                        Adjustment:
                        <span id="adjustmentValue">0</span>
                        &nbsp; | &nbsp;
                        Net Stock:
                        <span id="netStock">@Model.Summary.WarehouseStock</span>
                    </div>
                    @if (Model.IsSuccess)
                    {
                        <div class="text-success fw-semibold">
                            Inventory added successfully.
                            <a asp-page="../Index"
                               asp-route-skuId="@Model.AdjustRequest.SKUId"
                               asp-route-warehouseId="@Model.AdjustRequest.WarehouseId"
                               class="ms-2 fw-bold">
                                View Inventory →
                            </a>
                        </div>
                    }
                    else if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger fw-semibold">
                            Please correct validation errors.
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">

                    @if (Model.HasSku && !Model.IsSuccess&& Model.Summary != null && Model.Summary.IsInitiated)
                    {
                        <button type="submit"
                                    form="adjustInventoryForm"
                                class="btn btn-primary">
                                Confirm
                        </button>
                         
                    }
                    else
                    {
                        <button class="btn btn-primary" disabled>
                                Confirm
                        </button>
                    }

                        <a asp-page="AdjustSkuStock"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- ================= LOG GRID ================= -->

    <div class="card mt-4">
        <div class="card-header fw-bold">
            Inventory Logs (Last 30 Days)
        </div>

        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Old</th>
                        <th>New</th>
                        <th>Reference</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td>@log.CreatedAt.ToString("dd-MMM")</td>
                            <td>@log.ChangeType</td>
                            <td>@log.Quantity</td>
                            <td>@log.OldStock</td>
                            <td>@log.NewStock</td>
                            <td>@log.ReferenceType</td>
                            <td>@log.Remarks</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const skuInput = document.getElementById("skuSearch");
            const skuList = document.getElementById("skuSuggestions");
            const skuIdInput = document.getElementById("SkuId");
            const productId = parseInt("@Model.ProductId") || 0;

            if (!skuInput || !skuList) {
                console.warn("SKU elements not found");
                return;
            }

            skuInput.addEventListener("input", async function () {
                const q = this.value.trim();

                if (!q || productId === 0) {
                    skuList.classList.add("d-none");
                    return;
                }
                //alert (productId+"q="+ q);
                const apiBase = document.querySelector('meta[name="api-base-url"]').getAttribute("content");
                const url = `${apiBase}/api/skufilter/skus?productId=${productId}&q=${encodeURIComponent(q)}`;
                //const url = `/api/skufilter/skus?productId=${productId}&q=${encodeURIComponent(q)}`;
                //console.log("Fetching:", url);
                //alert (productId+"url"+ url);
                const res = await fetch(url);
                if (!res.ok) return;

                const data = await res.json();
                console.log("SKU DATA:", data);
        //alert(JSON.stringify(data));

                skuList.innerHTML = "";

                if (!data.length) {
                    skuList.classList.add("d-none");
                    return;
                }

                data.forEach(sku => {
                    const li = document.createElement("li");
                    li.className = "list-group-item list-group-item-action";
                    li.textContent = `${sku.skuCode} | ${sku.variantText}`;

                    li.addEventListener("click", () => {
                        skuInput.value = li.textContent;
                        skuIdInput.value = sku.skuId;
                        skuList.classList.add("d-none");
                        skuInput.closest("form").submit();
                    });

                    skuList.appendChild(li);
                });

                skuList.classList.remove("d-none");
            });

            document.addEventListener("click", e => {
                if (!skuList.contains(e.target) && e.target !== skuInput) {
                    skuList.classList.add("d-none");
                }
            });
        });
    </script>

    <script>
        function recalculateStock() {

            const currentStockEl = document.getElementById("currentStock");
            const netStockEl = document.getElementById("netStock");
            const adjustmentEl = document.getElementById("adjustmentValue");

            if (!currentStockEl || !netStockEl || !adjustmentEl) return;

            const currentStock = parseInt(currentStockEl.innerText) || 0;

            const qtyInput =
                document.querySelector('input[name="AdjustRequest.Quantity"]');

            const typeSelect =
                document.querySelector('select[name="AdjustRequest.ChangeType"]');

            if (!qtyInput || !typeSelect) return;

            const qty = parseInt(qtyInput.value) || 0;
            const type = typeSelect.value;

            let netStock = currentStock;
            let displayAdj = 0;

            if (qty > 0) {
                if (type === "IN") {
                    netStock = currentStock + qty;
                    displayAdj = "+" + qty;
                } else {
                    netStock = currentStock - qty;
                    displayAdj = "-" + qty;
                }
            }

            adjustmentEl.innerText = displayAdj;
            netStockEl.innerText = netStock;
        }
    </script>
}
