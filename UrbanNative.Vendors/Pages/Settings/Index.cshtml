@page
@model UrbanNative.Vendors.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<h5 class="fw-bold mb-4">Vendor System Settings</h5>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">

        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Setting</th>
                    <th>Description</th>
                    <th style="width:160px;">Value</th>
                    <th style="width:180px;">Effective From</th>
                    <th >History</th>
                    <th style="width:120px;" class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Settings)
                {
                    <tr id="row-@item.SystemSettingId">
                        <td class="fw-semibold">@item.DisplayName</td>
                        <td class="text-muted small">@item.Description</td>

                        <!-- VALUE CELL -->
                        <td>
                            <span class="view-value">@item.CurrentValue</span>

                            <input class="form-control form-control-sm edit-value d-none"
                                   type="number"
                                   step="0.01"
                                   value="@item.CurrentValue" />
                        </td>

                        <td>
                            @(item.EffectiveFrom?.ToString("dd MMM yyyy HH:mm") ?? "-")
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-secondary"
                                    onclick="openHistory(@item.SystemSettingId)">
                                <i class="bi bi-clock-history"></i>
                            </button>
                        </td>

                        <td class="text-end">
                            @if (!item.OnlyAdminEditable)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary btn-edit"
                                        onclick="enableEdit(@item.SystemSettingId)">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-success btn-save d-none"
                                        onclick="submitRow(@item.SystemSettingId)">
                                    <i class="bi bi-check"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled
                                        title="Admin managed">
                                    <i class="bi bi-lock"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            
            </tbody>
        </table>

        <!-- HIDDEN FORM -->
        <form method="post" asp-page-handler="Update" id="editForm">
            <input type="hidden" name="EditModel.SystemSettingId" />
            <input type="hidden" name="EditModel.NewValue" />
        </form>

    </div>
</div>
<!-- History Modal  -->
<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Setting History</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Value</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody id="historyBody">
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        let activeRow = null;

        function enableEdit(id) {
            // Disable previous row
            if (activeRow && activeRow !== id) {
                disableEdit(activeRow);
            }

            activeRow = id;

            const row = document.getElementById("row-" + id);
            row.querySelector(".view-value").classList.add("d-none");
            row.querySelector(".edit-value").classList.remove("d-none");

            row.querySelector(".btn-edit").classList.add("d-none");
            row.querySelector(".btn-save").classList.remove("d-none");
        }

        function disableEdit(id) {
            const row = document.getElementById("row-" + id);
            row.querySelector(".view-value").classList.remove("d-none");
            row.querySelector(".edit-value").classList.add("d-none");

            row.querySelector(".btn-edit").classList.remove("d-none");
            row.querySelector(".btn-save").classList.add("d-none");
        }

        function submitRow(id) {
            const row = document.getElementById("row-" + id);
            const value = row.querySelector(".edit-value").value;

            document.querySelector('[name="EditModel.SystemSettingId"]').value = id;
            document.querySelector('[name="EditModel.NewValue"]').value = value;

            document.getElementById("editForm").submit();
        }
    </script>

    <script>
                function openHistory(settingId) {

            const body = document.getElementById("historyBody");
            body.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Loading...
                    </td>
                </tr>`;

            fetch(`?handler=History&settingId=${settingId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed");
                    return res.json();
                })
                .then(data => {

                    body.innerHTML = "";

                    if (!data || data.length === 0) {
                        body.innerHTML = `
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No history available
                                </td>
                            </tr>`;
                        return;
                    }

                    data.forEach(row => {
                        body.innerHTML += `
                            <tr>
                                <td>${row.value}</td>
                                <td>${formatDate(row.effectiveFrom)}</td>
                                <td>${row.effectiveTo ? formatDate(row.effectiveTo) : 'Active'}</td>
                                <td>
                                    <span class="badge ${row.source === 'VENDOR' ? 'bg-primary' : 'bg-secondary'}">
                                        ${row.source}
                                    </span>
                                </td>
                            </tr>`;
                    });
                })
                .catch(() => {
                    body.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-danger text-center">
                                Failed to load history
                            </td>
                        </tr>`;
                });

            new bootstrap.Modal(
                document.getElementById("historyModal")
            ).show();
        }

        function formatDate(dateStr) {
            return new Date(dateStr).toLocaleString();
        }
    </script>

}
