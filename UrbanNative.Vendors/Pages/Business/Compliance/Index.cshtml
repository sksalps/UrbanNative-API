@page
@model UrbanNative.Vendors.Pages.Business.Compliance.IndexModel

<h3 class="mb-3">Compliance Dashboard</h3>

<!-- 🔝 Summary -->
<div class="card p-3 mb-4">
    <div class="row">
        <div class="col-md-4">
            <strong>Status:</strong>
            <span class="badge bg-success">@Model.Summary?.ApprovalStatus</span>
        </div>
        <div class="col-md-4">
            <strong>Approved On:</strong>
            @Model.Summary?.ApprovedOn?.ToString("dd MMM yyyy") ?? "-"
        </div>
        <div class="col-md-4">
            <strong>Payout Eligible:</strong>
            @Model.Summary?.PayoutEligibleOn?.ToString("dd MMM yyyy") ?? "-"
        </div>
    </div>

    <div class="mt-3">
        <strong>Overall Progress:</strong>
        <div class="progress">
            <div class="progress-bar"
                 role="progressbar"
                 style="width:@Model.Summary?.OverallProgressPercent%">
                @Model.Summary?.OverallProgressPercent%
            </div>
        </div>
    </div>
</div>

<!-- 📊 Horizontal Category Progress Strip -->
<div class="card p-3 mb-4">
    <div class="d-flex flex-wrap gap-4">
        @foreach (var cat in Model.Categories)
        {
            var percent = cat.ProgressPercent;
            var color = cat.IsComplete ? "bg-success" : "bg-warning";

            <div style="min-width:150px;">
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar @color"
                         role="progressbar"
                         style="width:@percent%">
                    </div>
                </div>
                <small class="text-muted">
                    <strong>@cat.GroupName</strong> @cat.ApprovedDocs/@cat.MinRequired
                </small>
            </div>
        }
    </div>
</div>

<!-- 📋 Category Grid -->
<div class="card p-3">
    <h5>Compliance Categories</h5>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Total Docs</th>
                <th>Uploaded</th>
                <th>Approved</th>
                <th>Last Updated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.CategoryGrid)
            {
                <tr style="cursor:pointer;"
                    onclick="location.href='?SelectedGroupId=@row.GroupID'">
                    <td>@row.GroupName</td>
                    <td>@row.TotalDocs</td>
                    <td>@row.UploadedDocs</td>
                    <td>@row.ApprovedDocs</td>
                    <td>@row.LastUpdated?.ToString("dd MMM yyyy")</td>
                </tr>


            }
        </tbody>
    </table>
</div>

<!-- 📄 Document Grid Placeholder -->
@if (Model.SelectedGroupId.HasValue)
{
    <div class="card p-3 mt-4">
        <h5>Documents</h5>

        @if (!Model.Documents.Any())
        {
            <p class="text-muted">No documents found.</p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Status</th>
                        <th>Expiry</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        var statusColor = doc.VerificationStatus switch
                        {
                            "APPROVED" => "success",
                            "PENDING" => "warning",
                            "REJECTED" => "danger",
                            _ => "secondary"
                        };

                        <tr style="cursor:pointer;"
                            onclick="location.href='?SelectedGroupId=@Model.SelectedGroupId&SelectedComplianceId=@doc.ComplianceID'">

                            <td>
                                @doc.ComplianceName
                                @if (doc.IsMandatoryInGroup)
                                {
                                    <span class="badge bg-danger ms-2">Mandatory</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@statusColor">
                                    @doc.VerificationStatus ?? "Not Uploaded"
                                </span>
                            </td>
                            <td>@doc.ExpiryDate?.ToString("dd MMM yyyy")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" disabled>
                                    @doc.ActionType
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else
{
    <div class="card p-3 mt-4">
        <h5>Documents</h5>
        <p class="text-muted">Select a category to view documents.</p>
    </div>
}

<!-- 📄 Category  Status Banner -->
@if (Model.SelectedGroupId.HasValue && Model.CategoryStatus != null)
{
    var status = Model.CategoryStatus;
    var isComplete = status.IsComplete;
    var bannerColor = isComplete ? "success" : "warning";

    <div class="alert alert-@bannerColor mt-3">
        <strong>@status.GroupName Status:</strong>

        @if (status.MissingMandatoryDocs > 0)
        {
            <span>
                Mandatory document(s) missing. Please upload required document(s).
            </span>
        }
        else if (isComplete)
        {
            <span>
                Complete (@status.ApprovedDocs / @status.MinRequired documents approved)
            </span>
        }
        else
        {
            <span>
                @status.ApprovedDocs of @status.MinRequired required documents approved.
            </span>
        }
    </div>
}
<!-- 📚 History Grid Placeholder -->
@if (Model.SelectedComplianceId.HasValue)
{
    <div class="card p-3 mt-4">
        <h5>Document History</h5>

        @if (!Model.History.Any())
        {
            <p class="text-muted">No history available.</p>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Status</th>
                        <th>Uploaded</th>
                        <th>Verified</th>
                        <th>Expiry</th>
                        <th>Version</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.History)
                    {
                        var statusColor = item.VerificationStatus switch
                        {
                            "APPROVED" => "success",
                            "PENDING" => "warning",
                            "REJECTED" => "danger",
                            _ => "secondary"
                        };

                        <tr>
                            <td>@item.FileName</td>
                            <td>
                                <span class="badge bg-@statusColor">
                                    @item.VerificationStatus
                                </span>
                            </td>
                            <td>@item.UploadedAt.ToString("dd MMM yyyy")</td>
                            <td>@item.VerifiedAt?.ToString("dd MMM yyyy")</td>
                            <td>@item.ExpiryDate?.ToString("dd MMM yyyy")</td>
                            <td>@item.VersionStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
else if (Model.SelectedGroupId.HasValue)
{
    <div class="card p-3 mt-4">
        <h5>Document History</h5>
        <p class="text-muted">Select a document to view history.</p>
    </div>
}