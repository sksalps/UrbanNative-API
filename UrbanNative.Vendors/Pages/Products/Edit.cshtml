@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit Product";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-3">

    <h4 class="mb-0">Edit Product</h4>

    <span class="badge
        @(Model.ViewProduct.ApprovalStatus == "APPROVED" ? "bg-success" :
                    Model.ViewProduct.ApprovalStatus == "REJECTED" ? "bg-danger" :
                    "bg-warning text-dark")"
          data-bs-toggle="tooltip"
          data-bs-placement="right"
          title="@(string.IsNullOrWhiteSpace(Model.ViewProduct.RejectedReason)
                            ? "No remarks available"
                            : Model.ViewProduct.RejectedReason)">
        @Model.ViewProduct.ApprovalStatus
    </span>

</div>

@if (Model.IsApproved)
{
    <div class="alert alert-info">
        This product is approved. Some fields are locked.
    </div>
}

<form method="post" class="card shadow-sm">
    <input type="hidden" asp-for="Product.ProductID" />

    <div class="card-body">

        <!-- BASIC INFO -->
        <div class="row g-3">

            <!-- Category -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Category <span class="text-danger">*</span>
                </label>
                <select asp-for="Product.CategoryID"
                        asp-items="Model.CategoryList"
                        class="form-select"
                        id="ddlCategory"
                        disabled="@Model.IsApproved">
                </select>

                @if (Model.IsApproved)
                {
                    <input type="hidden" asp-for="Product.CategoryID" />
                }

                <small id="hsnMeta" class="text-muted d-block mt-1">
                    HSN & GST auto from category
                </small>
            </div>

            <!-- Product Name -->
            <div class="col-md-8">
                <label class="form-label fw-semibold">
                    Product Name <span class="text-danger">*</span>
                </label>
                <input asp-for="Product.ProductName"
                       class="form-control"
                       disabled="@Model.IsApproved" />

                @if (Model.IsApproved)
                {
                    <input type="hidden" asp-for="Product.ProductName" />
                }

                <span asp-validation-for="Product.ProductName"
                      class="text-danger"></span>
            </div>
        </div>

        <!-- Description -->
        <div class="mt-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea asp-for="Product.Description"
                      class="form-control"
                      rows="3"></textarea>
        </div>

        <!-- PRICING & VARIANTS -->
        <div class="row g-3 mt-3 align-items-start">

            <!-- MRP -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    MRP <span class="text-danger">*</span>
                </label>
                <input asp-for="Product.MRP" class="form-control" />
                <span asp-validation-for="Product.MRP"
                      class="text-danger"></span>
            </div>

            <!-- Discount -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">Discount Price</label>
                <input asp-for="Product.DiscountPrice" class="form-control" />
                <small class="text-muted">
                    If empty, Discount = MRP
                </small>
            </div>

            <!-- Shared Margin -->
            <div class="col-md-3">
                <label class="form-label fw-semibold">
                    Shared Margin (%) <span class="text-danger">*</span>
                </label>
                <input asp-for="Product.VendorSharedMargin"
                       class="form-control"
                       id="txtSharedMargin"
                       disabled="@Model.IsApproved" />

                @if (Model.IsApproved)
                {
                    <input type="hidden" asp-for="Product.VendorSharedMargin" />
                }

                <span asp-validation-for="Product.VendorSharedMargin"
                      class="text-danger"></span>
            </div>

            <!-- Has Variants -->
            <div class="col-md-3 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input asp-for="Product.HasVariants"
                           class="form-check-input"
                           disabled="@(Model.IsApproved && Model.ViewProduct.HasVariants)" />

                    @if (Model.IsApproved && Model.ViewProduct.HasVariants)
                    {
                        <input type="hidden" asp-for="Product.HasVariants" />
                    }

                    <label class="form-check-label fw-semibold">
                        Has Variants
                    </label>
                </div>
            </div>
        </div>

        <!-- RETURN POLICY & WAREHOUSE -->
        <div class="row g-3 mt-3 align-items-start">

            <!-- Return Policy -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Return Policy <span class="text-danger">*</span>
                </label>
                <select asp-for="Product.ReturnPolicyID"
                        asp-items="Model.ReturnPolicyList"
                        class="form-select">
                </select>
                <span asp-validation-for="Product.ReturnPolicyID"
                      class="text-danger"></span>
            </div>

            <!-- Warehouse -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Warehouse <span class="text-danger">*</span>
                </label>
                <select asp-for="Product.VendorWarehouseAddressID"
                        asp-items="Model.WarehouseList"
                        class="form-select"
                        id="ddlWarehouse"
                        disabled="@Model.IsApproved">
                </select>

                @if (Model.IsApproved)
                {
                    <input type="hidden"
                           asp-for="Product.VendorWarehouseAddressID" />
                }

                <span asp-validation-for="Product.VendorWarehouseAddressID"
                      class="text-danger"></span>
            </div>

            <!-- Warehouse Preview -->
            <div class="col-md-4">
                <div id="warehousePreview"
                     class="border rounded p-3 bg-light small d-none">
                </div>
            </div>

        </div>

    </div>

    <div class="card-footer text-end">
        <button type="submit" class="btn btn-primary px-4">Update</button>
        <a asp-page="./Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const ddlCategory = document.getElementById('ddlCategory');
            const ddlWarehouse = document.getElementById('ddlWarehouse');

            const hsnMeta = document.getElementById('hsnMeta');
            const txtSharedMargin = document.getElementById('txtSharedMargin');
            const warehousePreview = document.getElementById('warehousePreview');

            /* ===============================
               CATEGORY → HSN / GST / MARGIN
               =============================== */
            function loadCategory(categoryId) {
                if (!categoryId) return;
                //alert (categoryId);
                fetch(`?handler=CategoryHsn&categoryId=${categoryId}`)
                    .then(r => r.json())
                    .then(d => {
                        hsnMeta.innerText =
                            `HSN ${d.hsnCode} • GST ${d.gstPercentage}%`;

                        if (txtSharedMargin && !txtSharedMargin.disabled) {
                            txtSharedMargin.value = d.sharedMargin;
                        }
                    })
                    .catch(() => {
                        hsnMeta.innerText = 'HSN / GST not configured';
                    });
            }

            /* ===============================
               WAREHOUSE → ADDRESS PREVIEW
               =============================== */
            function loadWarehouse(addressId) {
                if (!addressId) return;

                fetch(`${window.location.pathname}?handler=WarehousePreview&warehouseId=${addressId}`)
                    .then(r => r.json())
                    .then(w => {
                        warehousePreview.classList.remove('d-none');
                        warehousePreview.innerHTML = `
                            <strong>${w.addressName}</strong><br/>
                            ${w.addressLine1}<br/>
                            ${w.addressLine2 ? w.addressLine2 + '<br/>' : ''}
                            ${w.landmark ? w.landmark + '<br/>' : ''}
                            ${w.cityName ?? ''}${w.stateName ? ', ' + w.stateName : ''}${w.countryName ? ', ' + w.countryName : ''} – ${w.pincode}
                        `;
                    });
            }

            ddlCategory?.addEventListener('change', () =>
                loadCategory(ddlCategory.value));

            ddlWarehouse?.addEventListener('change', () =>
                loadWarehouse(ddlWarehouse.value));

            // Initial load
            if (ddlCategory?.value) loadCategory(ddlCategory.value);
            if (ddlWarehouse?.value) loadWarehouse(ddlWarehouse.value);

        });
    </script>

}
