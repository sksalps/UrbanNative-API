@page "{productId:int}"
@model UrbanNative.Vendors.Pages.Products.SkuEntryModel

@{
    ViewData["Title"] = "SKU Entry";
}

<!-- ========================= -->
<!-- PAGE HEADER (READ ONLY)  -->
<!-- ========================= -->
<div class="card mb-3">
    <div class="card-body">
        <h4 class="mb-1">@Model.Header.ProductName</h4>

        <div class="text-muted mb-2">
            @Model.Header.CategoryPath
        </div>

        <div class="row">
            <div class="col-md-4">
                <strong>Variant Set:</strong> @Model.Header.VariantSetName
            </div>
            <div class="col-md-4">
                <strong>Total Possible SKUs:</strong> @Model.Header.TotalPossibleSkus
            </div>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- VALIDATION SUMMARY       -->
<!-- ========================= -->
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<!-- ========================= -->
<!-- SUCCESS MESSAGE           -->
<!-- ========================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- ========================= -->
<!-- SKU GRID                  -->
<!-- ========================= -->
<form method="post">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th style="width:20%">Variant Combination</th>
                <th style="width:10%">SKU Code</th>
                <th style="width:10%">Price (MRP)</th>
                <th style="width:15%">Discounted1 Price</th>
                <th style="width:10%">Stock</th>
                <th style="width:15%">Images</th>
                <th style="width:10%">           Inventory                </th>
                <th style="width:10%">Active</th>


            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Skus.Count; i++)
            {
                <tr>
                    <!-- ========================= -->
                    <!-- Variant Combination       -->
                    <!-- ========================= -->
                    <td>
                        @Model.Skus[i].VariantDisplay
                        <input type="hidden" asp-for="Skus[i].SKUId" />
                    </td>

                    <!-- ========================= -->
                    <!-- SKU Code                  -->
                    <!-- ========================= -->
                    <td>
                        <input class="form-control"
                               value="@Model.Skus[i].SKUCode"
                               readonly />
                    </td>

                    <!-- ========================= -->
                    <!-- Price (MRP)               -->
                    <!-- ========================= -->
                    <td>
                        <input asp-for="Skus[i].Price"
                               class="form-control"
                               placeholder="Enter MRP" />
                        <span asp-validation-for="Skus[i].Price" class="text-danger"></span>
                    </td>

                    <!-- ========================= -->
                    <!-- Discount Price            -->
                    <!-- ========================= -->
                    <td>
                        <input asp-for="Skus[i].DP"
                               class="form-control"
                               placeholder="Enter DP" />
                        <span asp-validation-for="Skus[i].DP" class="text-danger"></span>
                    </td>

                    <!-- ========================= -->
                    <!-- Stock                     -->
                    <!-- ========================= -->
                    <td class="text-center">
                        @if (Model.Skus[i].IsStockLocked)
                        {
                            <!-- 🔒 Preserve stock on POST -->
                            <input type="hidden"
                                   asp-for="Skus[i].Stock"
                                   value="@Model.Skus[i].CurrentStock" />

                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <input class="form-control text-center"
                                       style="max-width:80px"
                                       value="@Model.Skus[i].CurrentStock"
                                       readonly
                                       disabled />

                                <span class="text-muted"
                                      data-bs-toggle="tooltip"
                                      title="Managed via Inventory. INIT: @Model.Skus[i].InitStock | Current: @Model.Skus[i].CurrentStock">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                            </div>
                        }
                        else
                        {
                            <input asp-for="Skus[i].Stock"
                                   class="form-control text-center"
                                   style="max-width:80px"
                                   min="0" />
                        }
                    </td>

                    <!-- ========================= -->
                    <!-- Images                    -->
                    <!-- ========================= -->
                    <td class="text-center">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                data-sku-id="@Model.Skus[i].SKUId">
                            Manage1 (@Model.Skus[i].ImageCount)
                        </button>
                    </td>
                    <td>
                        <a asp-page="/Inventory/Index"
                           asp-route-skuId="@Model.Skus[i].SKUId">
                            View Inventory
                        </a>
                        |
                        <a asp-page="/Inventory/Add" asp-route-productId="Skus[i].SKUId">Add</a>
                    </td>
                    <!-- ========================= -->
                    <!-- Active                    -->
                    <!-- ========================= -->
                    <td class="text-center">
                        @if (
                                            (Model.Skus[i].IsStockLocked && Model.Skus[i].CurrentStock == 0)
                                            || Model.Skus[i].Price == 0
                                            || Model.Skus[i].DP == 0
                                            )
                        {
                            <!-- 🔒 Force false on POST -->
                            <input type="hidden"
                                   asp-for="Skus[i].IsActive"
                                   value="false" />

                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@Model.Skus[i].IsActive"
                                   disabled
                                   data-bs-toggle="tooltip"
                                   title="Cannot activate SKU when stock or price is zero" />

                            <span asp-validation-for="Skus[i].IsActive" class="text-danger"></span>
                        }
                        else
                        {
                            <input asp-for="Skus[i].IsActive"
                                   type="checkbox"
                                   class="form-check-input" />

                            <span asp-validation-for="Skus[i].IsActive" class="text-danger"></span>
                        }
                    </td>
                    
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3 text-end">
        <button type="submit" class="btn btn-success px-4">
            Save SKUs
        </button>
        <a asp-page="/Products/Index" class="btn btn-secondary ms-2">
            Back
        </a>
    </div>
</form>
