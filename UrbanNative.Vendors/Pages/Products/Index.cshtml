@page
@model IndexModel
@{
    ViewData["Title"] = "My Products";
}

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Category</th>
            <th>SKU Status</th>
            <th>Approval</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.CategoryName</td>
                <td><span class="badge">@p.SkuStatus</span></td>
                <td>@p.ApprovalStatus</td>
                <td>@(p.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@p.ProductID">Edit</a> |
                    <a asp-page="Skus/Index" asp-route-productId="@p.ProductID">SKUs</a>
                </td>
            </tr>
        }
    </tbody>
</table>