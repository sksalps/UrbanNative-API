@page
@model IndexModel
@{
    ViewData["Title"] = "My Products";
}

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            <div class="col-lg-4">
                <label class="form-label fw-semibold">Search</label>
                <input type="text"
                       name="SearchText"
                       value="@Model.SearchText"
                       class="form-control"
                       placeholder="Product / Category / SKU" />
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All</option>
                    @foreach (var c in Model.CategoryList)
                    {
                        <option value="@c.CategoryID"
                                selected="@(c.CategoryID == Model.CategoryId)">
                            @c.CategoryName
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <label class="form-label fw-semibold">HSN (GST %)</label>
                <select name="hsnId" class="form-select">
                    <option value="">All</option>
                    @foreach (var h in Model.HsnList)
                    {
                        <option value="@h.HSNId"
                                selected="@(h.HSNId == Model.HsnId)">
                            @h.HSNCode (@h.GSTPercentage%)
                        </option>
                    }
                </select>
            </div>

            <div class="col-lg-4 text-end">
                <button type="submit" class="btn btn-primary px-4 me-2">
                    Search
                </button>

                <a asp-page="./Index" class="btn btn-outline-secondary me-2">
                    Reset
                </a>

                <a asp-page="./Create" class="btn btn-success px-3">
                    + Add Product
                </a>
            </div>

        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Category</th>
            <th>HSN Code</th>
            <th>SKU Status</th>
            <th>Approval</th>
            <th>Active</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.CategoryName</td>
                <td>
                    @p.HSNCode
                    <small class="text-muted">(@p.GSTPercentage%)</small>
                </td>

                <td>
                    <span class="badge badge-sku @p.SkuStatus.Replace(" ", "").ToLower()">
                        @p.SkuStatus
                    </span>
                </td>
                <td>@p.ApprovalStatus</td>
                <td>@(p.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@p.ProductID">Edit</a> |
                    <a asp-page="Skus/Index" asp-route-productId="@p.ProductID">SKUs</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .badge-sku.novariants {
        background: #6c757d;
    }

    .badge-sku.nosku {
        background: #fd7e14;
    }

    .badge-sku.novendors {
        background: #dc3545;
    }

    .badge-sku.active {
        background: #198754;
    }
</style>