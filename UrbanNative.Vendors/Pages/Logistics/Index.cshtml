@page
@model UrbanNative.Vendors.Pages.Logistics.IndexModel
@{
    ViewData["Title"] = "Vendor Logistics";
}

<div class="container-fluid">

    <!-- ================= FILTER BAR ================= -->
    <form method="post" asp-page-handler="Search" id="logisticsFilterForm">
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-center">

                    <!-- Smart Search -->
                    <div class="col-md-6 position-relative">
                        <input asp-for="Filter.SearchText"
                               id="logisticsSearchInput"
                               class="form-control"
                               placeholder="Order No / SKU / Shipment ID / Return ID / AWB"
                               autocomplete="off" />

                        <ul id="logisticsSearchDropdown"
                            class="list-group position-absolute w-100 d-none"
                            style="z-index:1000;">
                        </ul>
                    </div>

                    <!-- Show Completed -->
                    <div class="col-md-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Filter.ShowCompleted"
                                   id="toggleCompleted">
                            <label class="form-check-label" for="toggleCompleted">
                                Show Completed
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 text-end">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- ================= GRID 1 ================= -->
    <div class="card">
        <div class="card-header">
            <strong>Orders</strong>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height:320px;">
                <table class="table table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Order No</th>
                            <th>Order Date</th>
                            <th>Delivery By</th>
                            <th>Customer</th>
                            <th>City-State</th>
                            <th>NOP</th>
                            <th>Items</th>
                            <th>Last Update</th>
                            <th>Status</th>
                            <th style="width:90px;">Action</th>
                        </tr>
                    </thead>

                    <tbody id="ordersGridBody">
                        @await Html.PartialAsync("_OrdersGrid1", Model)
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= GRID 2 : DISPATCH ITEMS ================= -->
    <!-- 🔑 ID MUST MATCH JS -->
    <div id="grid2Container" class="mt-3"></div>

    <!-- ================= GRID 3 : SHIPMENTS ================= -->
    <div id="grid3Container" class="mt-3"></div>

</div>

<!-- ================= UPDATE SHIPMENT MODAL ================= -->
<div class="modal fade" id="updateShipmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- ❗ JS HANDLES SUBMIT -->
            
            <form id="updateShipmentForm"
                  onsubmit="event.preventDefault(); submitShipmentForm();">
                  @Html.AntiForgeryToken()


                <div class="modal-header">
                    <h5 class="modal-title">Update Shipment Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" asp-for="UpdateShipment.ShipmentID"id="UpdateShipment_ShipmentID" />

                    <div class="mb-3">
                        <label class="form-label">Logistics Provider</label>
                        <select asp-for="UpdateShipment.LogisticsProviderID"
                                class="form-select"
                                id="ddlLogisticsProvider">
                            <option value="">-- Select Provider --</option>
                            @foreach (var lp in Model.LogisticsProviders)
                            {
                                <option value="@lp.LogisticsProviderID">
                                    @lp.ProviderName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Shipment Status</label>
                        <select asp-for="UpdateShipment.NewShipmentStatus"
                                class="form-select"
                                id="ddlShipmentStatus"
                                onchange="toggleAwbFields()">
                            <option value="">-- Select Status--</option>
                            <option value="READY_TO_SHIP">Ready To Ship</option>
                            <option value="PICKUP_SCHEDULED">Pickup Scheduled</option>
                            <option value="PICKED_UP">Picked Up</option>
                            <option value="IN_TRANSIT">In Transit</option>
                            <option value="OUT_FOR_DELIVERY">Out for Delivery</option>
                            <option value="DELIVERED">Delivered</option>
                            <option value="FAILED_HOLD">FAILED HOLD</option>
                            <option value="RETURN_TO_ORIGIN">RTO</option>
                        </select>
                    </div>

                    <div class="mb-3" id="awbBlock" style="display:none;">
                        <label class="form-label">AWB / Tracking No</label>
                        <input asp-for="UpdateShipment.TrackingNo"
                               id="UpdateShipment_TrackingNo"
                               class="form-control" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
<script>
    const LOGISTICS_BASE_URL = '@Url.Page("/Logistics/Index")';
</script>
