@page
@model UrbanNative.Vendors.Pages.Wallet.IndexModel
@{
    ViewData["Title"] = "Wallet Ledger";
}

<h4 class="mb-4">Wallet Ledger</h4>

<!-- ================= FILTER CARD ================= -->
<form method="get" class="card p-3 mb-4">
    <div class="row g-3">

        <!-- From Date -->
        <div class="col-md-2">
            <label class="form-label">From Date</label>
            <input asp-for="Filter.FromDate" type="date" class="form-control" />
        </div>

        <!-- To Date -->
        <div class="col-md-2">
            <label class="form-label">To Date</label>
            <input asp-for="Filter.ToDate" type="date" class="form-control" />
        </div>

        <!-- Txn Type -->
        <div class="col-md-2">
            <label class="form-label">Transaction</label>
            <select asp-for="Filter.TxnType" class="form-select">
                <option value="">All</option>
                <option value="CR">Credit</option>
                <option value="DR">Debit</option>
            </select>
        </div>

        <!-- Source Type -->
        <div class="col-md-2">
            <label class="form-label">Source</label>
            <select asp-for="Filter.SourceType" class="form-select">
                <option value="">All</option>
                <option value="ORDER">Order</option>
                <option value="REFUND">Refund</option>
                <option value="RTO">RTO</option>
                <option value="SETTLEMENT">Settlement</option>
                <option value="ADJUSTMENT">Adjustment</option>
            </select>
        </div>

        <!-- Account Head -->
        <div class="col-md-2">
            <label class="form-label">Account Head</label>
            <select asp-for="Filter.AccountHeadId"
                    class="form-select"
                    asp-items="@(new SelectList(Model.AccountHeads, "AccountHeadId", "HeadName"))">
                <option value="">All</option>
            </select>
        </div>

        <!-- Order No -->
        <div class="col-md-2">
            <label class="form-label">Order No</label>
            <input asp-for="Filter.OrderNo" class="form-control" placeholder="Search order..." />
        </div>

        <!-- Buttons -->
        <div class="col-md-12 text-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
            <a asp-page="/Wallet/Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Reset
            </a>
        </div>

    </div>
</form>

<!-- ================= LEDGER GRID ================= -->
<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Txn</th>
                        <th>Source</th>
                        <th>Account Head</th>
                        <th>Order No</th>
                        <th>SKU</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Balance</th>
                        <th>Narration</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Rows != null && Model.Rows.Any())
                    {
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <span class="badge @(row.TxnType == "CR" ? "bg-success" : "bg-danger")">
                                        @row.TxnType
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @row.SourceType
                                    </span>
                                </td>
                                <td>@row.AccountHead</td>
                                <td>@row.OrderNo</td>
                                <td>@row.SKUCode</td>

                                <!-- Credit -->
                                <td class="text-end text-success fw-semibold">
                                    @(row.Credit > 0 ? row.Credit.ToString("N2") : "-")
                                </td>

                                <!-- Debit -->
                                <td class="text-end text-danger fw-semibold">
                                    @(row.Debit > 0 ? row.Debit.ToString("N2") : "-")
                                </td>

                                <!-- Running Balance -->
                                <td class="text-end fw-bold">
                                    @row.RunningBalance.ToString("N2")
                                </td>

                                <td>@row.Narration</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                No transactions found
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>
