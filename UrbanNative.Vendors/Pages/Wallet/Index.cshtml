@page
@model UrbanNative.Vendors.Pages.Wallet.IndexModel
@{
    ViewData["Title"] = "Wallet Ledger";
}

<h4 class="mb-4">Wallet Ledger</h4>

<!-- ================= FILTER CARD ================= -->
<form method="get" class="card p-3 mb-4">
    <div class="row g-3">
        <!-- Order No -->
        <div class="col-md-2 position-relative">
            <label class="form-label">Order / SKU</label>
            <input id="orderSearch" asp-for="Filter.OrderNo"
                   class="form-control"
                   placeholder="Search order / SKU / variant"
                   autocomplete="off" />

            <ul id="orderList" class="list-group position-absolute w-100 d-none" style="z-index:1000;"></ul>
        </div>


        <!-- Txn Type -->
        <div class="col-md-2">
            <label class="form-label">Transaction</label>
            <select asp-for="Filter.TxnType" class="form-select">
                <option value="">All</option>
                <option value="CREDIT">Credit</option>
                <option value="DEBIT">Debit</option>
            </select>
        </div>
        <!-- Account Head -->
        <div class="col-md-2">
            <label class="form-label">Account Head</label>
            <select asp-for="Filter.AccountHeadId"
                    class="form-select"
                    asp-items="@(new SelectList(Model.AccountHeads, "AccountHeadId", "HeadName"))">
                <option value="">All</option>
            </select>
        </div>
        <!-- From Date -->
        <div class="col-md-2">
            <label class="form-label">From Date</label>
            <input asp-for="Filter.FromDate" type="date" class="form-control" />
        </div>

        <!-- To Date -->
        <div class="col-md-2">
            <label class="form-label">To Date</label>
            <input asp-for="Filter.ToDate" type="date" class="form-control" />
        </div>
        <!-- Source Type -->
        <div class="col-md-2">
            <label class="form-label">Source</label>
            <select asp-for="Filter.FinancialEvent" class="form-select">
                <option value="">All</option>
                <option value="ORDER">Order</option>
                <option value="REFUND">Refund</option>
                <option value="RTO">RTO</option>
                <option value="SETTLEMENT">Settlement</option>
                <option value="ADJUSTMENT">Adjustment</option>
            </select>
        </div>

        <!-- Buttons -->
        <div class="col-md-12 text-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
            <a asp-page="/Wallet/Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Reset
            </a>
        </div>

    </div>
</form>
<div class="card mb-3">
    <div class="card-body">

        <!-- Line 1 -->
        <div class="row text-center fw-bold">
            <div class="col">C/F Balance<br>@Model.Summary.CFBalance</div>
            <div class="col text-success">Credit (Real)<br>@Model.Summary.CreditReal</div>
            <div class="col text-warning">Credit (Locked)<br>@Model.Summary.CreditLocked</div>
            <div class="col text-danger">Debit (Real)<br>@Model.Summary.DebitReal</div>
            <div class="col text-warning">Debit (Locked)<br>@Model.Summary.DebitLocked</div>
        </div>

        <hr />

        <!-- Line 2 -->
        <div class="row text-center fw-bold">
            <div class="col text-primary">Balance (Real)<br>@Model.Summary.BalanceReal</div>
            <div class="col text-secondary">Balance (Locked)<br>@Model.Summary.BalanceLocked</div>
            <div class="col text-success">Available Balance<br>@Model.Summary.BalanceReal</div>
            <div class="col text-dark">Ledger Balance<br>@(Model.Summary.LedgerBalance)</div>
        </div>

    </div>
</div>

<!-- ================= LEDGER GRID ================= -->
<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Account Head</th>
                        <th>Source</th>
                        <th>Reference No.</th>
                        <th>Order No</th>
                        <th>SKU</th>
                        <th>Narration</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Balance</th>
                        
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Rows != null && Model.Rows.Any())
                    {
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("dd-MMM-yyyy")</td>
                                <td>@row.AccountHead</td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @row.FinancialEvent
                                    </span>
                                </td>
                                <td>@row.ReferenceNo</td>
                                <td>@row.OrderNo</td>
                                <td>@row.SKUCode</td>
                                <td>@row.Narration</td>
                                <!-- Credit -->
                                <td class="text-end text-success fw-semibold">
                                    @(row.Credit > 0 ? row.Credit.ToString("N2") : "-")
                                </td>

                                <!-- Debit -->
                                <td class="text-end text-danger fw-semibold">
                                    @(row.Debit > 0 ? row.Debit.ToString("N2") : "-")
                                </td>

                                <!-- Running Balance -->
                                <td class="text-end fw-bold">
                                    @row.RunningBalance.ToString("N2")
                                </td>

                                
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                No transactions found
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>
@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {

    const input = document.getElementById("orderSearch");
    const list = document.getElementById("orderList");

    if (!input || !list) return;

    let debounceTimer;

    input.addEventListener("input", function () {
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(async () => {
            const q = input.value.trim();

            if (!q || q.length < 2) {
                list.classList.add("d-none");
                return;
            }

            const res = await fetch(`?handler=SmartSearch&term=${encodeURIComponent(q)}`);
            const data = await res.json();

            list.innerHTML = "";

            data.forEach(item => {
                const li = document.createElement("li");
                li.className = "list-group-item list-group-item-action";

                li.innerHTML = `
                    <div><strong>${item.orderNo}</strong></div>
                    <small class="text-muted">${item.skuCode} | ${item.variant}</small>
                `;

                li.onclick = () => {
                    input.value = item.orderNo; // filter by order
                    list.classList.add("d-none");
                };

                list.appendChild(li);
            });

            list.classList.toggle("d-none", data.length === 0);

        }, 300); // debounce
    });

});
</script>
}


