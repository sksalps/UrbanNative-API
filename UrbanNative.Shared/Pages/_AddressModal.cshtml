@* =========================
   ADDRESS MODAL
========================= *@

<div class="modal fade" id="addressModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="addressModeTitle">Add New Address</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                <div id="toastMsg" class="alert alert-success d-none"></div>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <!-- Address Type -->
                <div class="mb-3">
                    <label class="form-label">Address Type</label>
                    <input type="text"
                           id="addressTypeDisplay"
                           class="form-control form-control-lg"
                           disabled />
                </div>
                <!-- EXISTING ADDRESS -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Select Existing Address</label>
                    <select id="existingAddress" class="form-select" onchange="onAddressChange()">
                        <option value="">-- Select Address --</option>
                    </select>
                </div>

                <hr class="my-4" />

                <!-- NICKNAME -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Nick Name <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="nickname" class="form-control"
                           placeholder="Eg: Home, Office" />
                    <small class="text-danger d-none" id="err_nickname"></small>
                </div>
                <!-- PINCODE -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Pincode <span class="text-danger">*</span></label>
                    <input type="text" id="pincode" class="form-control"
                           placeholder="Type Pincode to autofill location"
                           onblur="fetchPincodeDetails()" />
                    <small class="text-muted">Auto-detect location from pincode</small>
                </div>

                <hr class="my-4" />
                <!-- LOCATION -->
                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Country <span class="text-danger">*</span>
                        </label>
                        <select id="country" class="form-select"></select>
                        <small class="text-danger d-none" id="err_country"></small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            State <span class="text-danger">*</span>
                        </label>
                        <select id="state" class="form-select"></select>
                        <small class="text-danger d-none" id="err_state"></small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            City <span class="text-danger">*</span>
                        </label>
                        <select id="city" class="form-select"></select>
                        <small class="text-danger d-none" id="err_city"></small>
                    </div>

                </div>
                <div class="mt-3">
                    <label class="form-label fw-semibold">Location Preview</label>

                    <div id="mapContainer" class="border rounded d-none" style="height:250px;">
                        <iframe id="mapFrame"
                                width="100%" height="100%"
                                style="border:0;"
                                loading="lazy">
                        </iframe>
                    </div>
                </div>
                <hr class="my-4" />
                <!-- ADDRESS LINE -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Address Line 1 <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="line1" class="form-control"
                           placeholder="Minimum 7 characters" />
                    <small class="text-danger d-none" id="err_line1"></small>
                </div>
                <!-- Address Line 2 -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Address Line 2</label>
                    <input type="text" id="line2" class="form-control"
                           placeholder="Optional" />
                </div>
                <!-- Landmark -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Landmark</label>
                    <input type="text" id="landmark" class="form-control"
                           placeholder="Nearby landmark" />
                </div>

                

                <!-- PRIMARY -->
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="isPrimary">
                    <label class="form-check-label">
                        Set as Primary Address
                    </label>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer justify-content-between">

                <button class="btn btn-outline-secondary"
                        onclick="clearAddressForm()">
                    Reset
                </button>

                <div>
                    <button id="cancel" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button id="btnSave"
                            class="btn btn-success px-4"
                            onclick="saveAddress()">
                        Save Address
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>

<!--script src="~/_content/UrbanNative.Shared/js/address-modal.js"></script -->

<script>
        let addressScriptLoaded = false;

    async function loadAddressEngine() {
        if (!addressScriptLoaded) {
            await loadScript('/_content/UrbanNative.Shared/js/address-modal.js');
            addressScriptLoaded = true;
        }
                //alert ("addressScriptLoaded11"+addressScriptLoaded);

        // Now safe to call
        openAddressModal('Warehouse');
    }

    function loadScript(src) {
        return new Promise((resolve, reject) => {
            let script = document.createElement('script');
            script.src = src;
            script.onload = resolve;
            script.onerror = reject;
            document.body.appendChild(script);
        });
    }


        function setAddressMode(isEdit) {

        const title = document.getElementById("addressModeTitle");
        const btn = document.getElementById("btnSave");

        if (isEdit) {
            title.innerText = "Edit Address";
            btn.innerText = "Update Address";
        } else {
            title.innerText = "Add New Address";
            btn.innerText = "Save Address";
        }
    }
</script>
