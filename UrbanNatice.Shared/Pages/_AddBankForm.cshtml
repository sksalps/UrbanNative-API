@model dynamic

<div class="card p-4">

    <!-- ================= UPLOAD ================= -->
    <div class="mb-4">
        <label class="form-label">Upload Cancelled Cheque</label>

        <input type="file" id="chequeFile" class="form-control"
               accept=".jpg,.png,.pdf"
               onchange="previewCheque(event)" />

        <img id="chequePreview" class="mt-3" style="max-height:200px; display:none;" />

        <button type="button" class="btn btn-secondary mt-2" onclick="extractAndAutofill()">
            Extract & Autofill
        </button>
    </div>

    <!-- ================= BANK ================= -->
    <div class="row g-3">

        <div class="col-md-6">
            <label>Account Holder Name</label>
            <input name="AccountHolderName" id="AccountHolderName"
                   value="@(Model?.AccountHolderName ?? "")"
                   class="form-control" />
        </div>

        <div class="col-md-6">
            <label>Account Number</label>
            <input name="AccountNo" id="AccountNo"
                   value="@(Model?.AccountNo ?? "")"
                   class="form-control"
                   pattern="^\d{9,18}$" required />
        </div>

        <div class="col-md-6">
            <label>IFSC Code</label>
            <input name="IFSCCode" id="IFSCCode"
                   value="@(Model?.IFSCCode ?? "")"
                   class="form-control"
                   pattern="^[A-Z]{4}0[A-Z0-9]{6}$" required />
        </div>

        <div class="col-md-6">
            <label>Bank Name</label>
            <input name="BankName" id="BankName"
                   value="@(Model?.BankName ?? "")"
                   class="form-control"
                   pattern="^[A-Za-z\s]{3,}$" />
        </div>

        <div class="col-md-6">
            <label>Branch</label>
            <input name="BranchName" id="BranchName"
                   value="@(Model?.BranchName ?? "")"
                   class="form-control" />
        </div>

        <div class="col-md-6">
            <label>UPI ID</label>
            <input name="UPIId" id="UPIId"
                   value="@(Model?.UPIId ?? "")"
                   class="form-control" />
        </div>

    </div>

    <!-- ================= ADDRESS ================= -->
    <hr />

    <h5>Bank Location</h5>

    <div class="row g-3">

        <div class="col-md-4">
            <label>Pincode</label>
            <input name="Pincode" id="Pincode"
                   value="@(Model?.Pincode ?? "")"
                   class="form-control"
                   maxlength="6"
                   onblur="fetchAddress()" />
        </div>

        <div class="col-md-4">
            <label>State</label>
            <input name="StateName" id="StateName"
                   value="@(Model?.StateName ?? "")"
                   class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label>City <span class="text-danger">*</span></label>
            <input name="CityName" id="CityName"
                   value="@(Model?.CityName ?? "")"
                   class="form-control" required />
        </div>

    </div>

</div>

<script>

    function previewCheque(e) {
        const file = e.target.files[0];
        if (!file) return;

        const img = document.getElementById("chequePreview");
        img.src = URL.createObjectURL(file);
        img.style.display = "block";
    }
    async function extractAndAutofill() {
        const fileInput = document.getElementById("chequeFile");
        const file = fileInput.files[0];

        if (!file) {
            alert("Please upload cancelled cheque first");
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        let formData = new FormData();
        formData.append("ChequeFile", file);

        const res = await fetch("/Business/AddBank?handler=ExtractOnly", {
            method: "POST",
            headers: {
                "RequestVerificationToken": token
            },
            body: formData
        });

        const result = await res.json();

        if (!result.isValid) {
            alert(result.message);
            return;
        }

        const f = result.extractedFields || {};

        document.getElementById("AccountHolderName").value = f.AccountHolderName || "";
        document.getElementById("AccountNo").value = f.AccountNo || "";
        document.getElementById("IFSCCode").value = f.IFSCCode || "";
        document.getElementById("BankName").value = f.BankName || "";
    }

    async function fetchAddress() {

        let pin = document.getElementById("Pincode").value;

        if (pin.length !== 6) return;

        try {
            const res = await fetch(`/api/common/pincode?pincode=${pin}`);
            const data = await res.json();

            document.getElementById("StateName").value = data.state || "";
            document.getElementById("CityName").value = data.city || "";
        }
        catch (err) {
            console.error(err);
        }
    }

</script>