<div class="card-box welcome-card">

    <div class="welcome-flex">

        <div>

            <div class="welcome-label">
                Welcome Back 👋
            </div>

            <div class="welcome-name">
                Hi @Model.FullName
            </div>

            <div class="welcome-subtitle">
                Explore, share & earn with UrbanNative
            </div>

            <div class="referral-chip">
                Referral: @Model.ReferralCode
            </div>

        </div>

        <div class="welcome-avatar">
            @Model.UserNickName?.Substring(0, 1)
        </div>

    </div>

</div>