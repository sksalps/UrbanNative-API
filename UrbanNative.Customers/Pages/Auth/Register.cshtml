@page
@model RegisterModel
@{
    Layout = "_PublicLayout";
}

<div class="card p-4 shadow-lg" style="max-width:420px;margin:auto;margin-top:60px;border-radius:18px;">

    <h4 class="text-center fw-bold mb-1">Connect to Your Native</h4>
    <p class="text-center text-muted small mb-3">Enter details to get your native products</p>

    @Html.AntiForgeryToken()

    <!-- Name -->
    <input asp-for="Name" class="form-control mb-1" placeholder="Full Name" />
    <div class="text-danger small" id="err_name"></div>


    <!-- MOBILE -->
    
    <div class="mb-2 position-relative">

        <input asp-for="Mobile" id="Mobile" class="form-control" placeholder="Mobile" />

        <!-- 🔥 Change FIRST -->
        
        <span id="changeMobile"
              class="position-absolute"
              style="top:50%; right:60px; transform:translateY(-50%); display:none; cursor:pointer;"
              onclick="resetMobile()"
              title="Change Mobile">
            ✏️
        </span>
        <!-- Verified -->
        <span id="verifiedBadge"
              class="badge bg-success position-absolute"
              style="top:50%; right:8px; transform:translateY(-50%); display:none;">
            ✔
        </span>

        <div class="text-danger small" id="err_mobile"></div>
    </div>

    <!-- EMAIL -->
    <div class="mb-2 position-relative">

        <input asp-for="Email" id="Email" class="form-control" placeholder="Email (optional)" />

        <!-- Change -->
        
        <a href="#"
               id="changeEmail"
               class="position-absolute text-primary"
               style="top:8px; right:90px; display:none;"
               onclick="resetEmail();return false;">

            <i class="bi bi-pencil-square"></i>
        </a>

        <!-- Verified -->
        <span id="emailVerifiedBadge"
              class="badge bg-success position-absolute"
              style="top:6px; right:8px; display:none;">
            ✔
        </span>

        <div class="text-danger small" id="err_email"></div>
    </div>

    <!-- OTP -->
    <div id="otpSection" style="display:none;">
        <div class="d-flex gap-2 mb-2">
            <input id="txtOtp" class="form-control text-center" maxlength="6" placeholder="Enter OTP" />

            <button id="btnRegVerifyOtp"
                    type="button"
                    class="btn btn-success"
                    onclick="verifyRegOtp()">
                Verify
            </button>
        </div>

        <div class="small text-muted mb-2">
            <span id="resendTimer">Resend in 30s</span>
            <a href="#" id="resendLink" style="display:none;" onclick="resendRegOtp();return false;">Resend</a>
        </div>
    </div>

    <!-- SEND OTP -->
    <button id="btnRegSendOtp" type="button" class="btn btn-dark w-100 mb-3">
        Send OTP
    </button>

    <!-- PINCODE -->
    <div class="input-group mb-2">
        <input asp-for="Pincode" id="txtPincode" class="form-control" placeholder="Pincode (optional)" />

        <button id="btnAddAddress"
                type="button"
                class="btn btn-outline-primary"
                disabled>
            + Address
        </button>
    </div>

    <!-- Address Preview -->
    <div id="addressPreview" class="small text-muted mb-3">
        No address selected
    </div>

    <!-- Hidden -->
    <input type="hidden" id="selectedAddressId" />
    <input type="hidden" id="referredByUserId" value="@Model.ReferredByUserID" />

    <!-- Submit -->
    <button id="btnRegister" type="button" class="btn btn-success w-100">
        Complete Registration
    </button>

</div>

@await Html.PartialAsync("~/Pages/_AddressModal.cshtml")

    <Style>
        
        #changeMobile i,
#changeEmail i {
    cursor: pointer;
    font-size: 16px;
}

#changeMobile i:hover,
#changeEmail i:hover {
    color: #0d6efd;
}

        /* Custom styles for the registration page */
        #otpSection input {
            font-size: 1.5rem;
            letter-spacing: 0.5rem;
        }

</Style>